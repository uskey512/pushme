#!/usr/bin/env bash
# pushme: send push notifications to your phone through ntfy.
# Must keep running on bash 3.2 (macOS /bin/bash): no associative arrays,
# ${var,,}, mapfile or namerefs.

set -u

# Byte semantics for ${#var}, substring slicing and [A-Z] ranges.
export LC_ALL=C

PUSHME_VERSION=0.1.0
EX_FAIL=1
EX_USAGE=2
ERROR_LOG_MAX=102400
NTFY_DEFAULT_URL=https://ntfy.sh
# ntfy delivers a body over 4,096 bytes as a file attachment instead of
# notification text.
NTFY_BODY_MAX=4000
# ntfy rejects a title over 1 KB, or tags over 512 bytes in total, with HTTP 400.
NTFY_TITLE_MAX=1000
NTFY_TAGS_MAX=512
# The attachment size limit of the ntfy.sh free tier.
NTFY_ATTACH_MAX_DEFAULT=2097152
TOPIC_RULE='英数字・「-」・「_」の 1〜64 文字'

usage() {
  cat <<'EOF'
pushme — スマートフォンにプッシュ通知を送る（ntfy）

使い方:
  pushme [send] [オプション] [メッセージ...]
  pushme run [オプション] [--on-fail-only] [--tail N] -- コマンド [引数...]
  pushme init [--force] [--no-test]
  pushme doctor
  pushme help | version

send と run のオプション:
  -t, --title TEXT       タイトル
  -p, --priority VALUE   優先度。1〜5 または min / low / default / high / urgent
  -T, --tags a,b         タグ（カンマ区切り。繰り返し指定できる）。末尾にホスト名タグが付く
  -c, --click URL        通知をタップしたときに開く URL
  -a, --attach FILE      ファイルを添付する
      --filename NAME    添付ファイルの表示名（既定はファイル名）
      --attach-url URL   外部の URL を添付する
      --markdown         本文を Markdown として表示する
      --no-host          ホスト名タグを付けない
  -q, --quiet            成功時に何も表示しない（cron ではメールが届かないよう付ける）
      --dry-run          送信せず、送る内容を表示する（トピック名とトークンは伏せ字）

send:
  引数を空白でつないで本文にする。引数がなく標準入力が端末でなければ標準入力を読む。
  「-」だけを指定したときも標準入力を読む。「--」以降の引数はすべてメッセージになる。
  4,000 バイトを超える本文は切り詰める。

run:
  コマンドを実行し、終わったら成否・終了コード・所要時間を通知する。
  終了コードはコマンドの終了コードそのまま（通知に失敗しても変わらない）。
  --on-fail-only   終了コードが 0 のときは通知しない
  --tail N         出力の末尾 N 行を本文に含める（標準エラーは標準出力に合流する）

init のオプション:
  --force     既存の設定ファイルを作り直す
  --no-test   最後にテスト通知を送るか尋ねない

終了コード: 0 = 成功、1 = 送信の失敗、2 = 使い方の誤り・設定の不足（run を除く）
設定ファイル: ~/.config/pushme/config（XDG_CONFIG_HOME や PUSHME_CONFIG で変更できる）
EOF
}

# --- output and logging ---------------------------------------------------

warn() { printf 'pushme: 警告: %s\n' "$1" >&2; }

# Errors are also logged because pushme usually runs where stderr is thrown
# away (cron jobs, editor hooks).
err() {
  printf 'pushme: エラー: %s\n' "$1" >&2
  log_error "$1"
}

die() {
  err "$2"
  exit "$1"
}

log_error() {
  local dir file size
  dir=${XDG_STATE_HOME:-${HOME:-}/.local/state}/pushme
  file=$dir/error.log
  {
    if [ ! -d "$dir" ]; then
      mkdir -p "$dir" && chmod 700 "$dir"
    fi
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" >>"$file"
    size=$(wc -c <"$file")
    if [ "$size" -gt "$ERROR_LOG_MAX" ]; then
      tail -c $((ERROR_LOG_MAX / 2)) "$file" | {
        IFS= read -r _
        cat
      } >"$file.tmp" && mv -f "$file.tmp" "$file"
    fi
  } 2>/dev/null
  return 0
}

# Shows a few leading characters of a secret and its length, never the rest.
mask() {
  local s=$1 keep
  keep=$((${#s} / 8))
  [ "$keep" -le 7 ] || keep=7
  printf '%s…(%d chars)' "${s:0:keep}" "${#s}"
}

redact() {
  local s=$1 secret masked
  for secret in "$cfg_ntfy_topic" "$cfg_ntfy_token"; do
    [ -n "$secret" ] || continue
    masked=$(mask "$secret")
    s=${s//"$secret"/"$masked"}
  done
  printf '%s' "$s"
}

# --- small helpers ---------------------------------------------------------

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

unquote() {
  local s=$1
  case $s in
    \"*\" | \'*\') s=${s:1:${#s}-2} ;;
  esac
  printf '%s' "$s"
}

join_words() {
  local IFS=' '
  REPLY="$*"
}

is_blank() {
  case $1 in
    *[![:space:]]*) return 1 ;;
  esac
  return 0
}

valid_topic() {
  case $1 in
    '' | *[!A-Za-z0-9_-]*) return 1 ;;
  esac
  [ "${#1}" -le 64 ]
}

normalize_priority() {
  case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    1 | min) REPLY=1 ;;
    2 | low) REPLY=2 ;;
    3 | default) REPLY=3 ;;
    4 | high) REPLY=4 ;;
    5 | urgent | max) REPLY=5 ;;
    *) return 1 ;;
  esac
}

# Splits on commas, trims each tag and drops empty ones.
normalize_tags() {
  local rest=$1, tag out=''
  while [ -n "$rest" ]; do
    tag=$(trim "${rest%%,*}")
    rest=${rest#*,}
    [ -n "$tag" ] && out=${out:+$out,}$tag
  done
  REPLY=$out
}

# Cuts $1 to at most $2 bytes including a trailing "…", without splitting a
# UTF-8 sequence. Pure bash because head -c and iconv differ between macOS
# and Linux.
truncate_utf8() {
  local s=$1 max=$2 ellipsis=$'\xe2\x80\xa6' n i need
  if [ "${#s}" -le "$max" ]; then
    REPLY=$s
    return
  fi
  s=${s:0:max-${#ellipsis}}
  n=${#s}
  i=$((n - 1))
  while [ "$i" -gt 0 ] && [ $((n - i)) -le 3 ]; do
    case ${s:i:1} in
      [$'\x80'-$'\xbf']) i=$((i - 1)) ;;
      *) break ;;
    esac
  done
  case ${s:i:1} in
    [$'\xc0'-$'\xdf']) need=2 ;;
    [$'\xe0'-$'\xef']) need=3 ;;
    [$'\xf0'-$'\xf7']) need=4 ;;
    *) need=1 ;;
  esac
  [ $((n - i)) -ge "$need" ] || s=${s:0:i}
  REPLY=$s$ellipsis
}

# Keeps the last $2 bytes of $1 behind a leading "…", starting on a UTF-8
# character boundary.
keep_tail_utf8() {
  local s=$1 max=$2 ellipsis=$'\xe2\x80\xa6' k=0
  if [ "${#s}" -le "$max" ]; then
    REPLY=$s
    return
  fi
  s=${s:$((${#s} - max + ${#ellipsis}))}
  while [ "$k" -lt 3 ]; do
    case ${s:0:1} in
      [$'\x80'-$'\xbf']) s=${s:1} ;;
      *) break ;;
    esac
    k=$((k + 1))
  done
  REPLY=$ellipsis$s
}

format_duration() {
  local h m s=$1
  h=$((s / 3600))
  m=$((s % 3600 / 60))
  s=$((s % 60))
  if [ "$h" -gt 0 ]; then
    REPLY=${h}h${m}m${s}s
  elif [ "$m" -gt 0 ]; then
    REPLY=${m}m${s}s
  else
    REPLY=${s}s
  fi
}

# Quotes words that contain whitespace or quotes, so the command line in a
# notification reads unambiguously.
format_command_line() {
  local arg escaped out='' q="'" q_escaped="'\\''"
  for arg in "$@"; do
    case $arg in
      '' | *[[:space:]]* | *"$q"*)
        escaped=${arg//"$q"/"$q_escaped"}
        arg="'$escaped'"
        ;;
    esac
    out=${out:+$out }$arg
  done
  REPLY=$out
}

# Some HTTP stacks mangle raw UTF-8 in headers, and ntfy decodes RFC 2047
# encoded-words in every header (https://docs.ntfy.sh/publish/#list-of-all-parameters).
# Values containing "=?" are encoded too, or the server would decode them.
header_value() {
  case $1 in
    *[!\ -~]* | *'=?'*)
      REPLY="=?UTF-8?B?$(printf '%s' "$1" | base64 | tr -d '\n')?="
      ;;
    *) REPLY=$1 ;;
  esac
}

default_hostname() {
  local h
  h=$(hostname -s 2>/dev/null) || h=
  [ -n "$h" ] || h=$(uname -n 2>/dev/null)
  printf '%s' "${h%%.*}"
}

file_mode() {
  stat -L -c '%a' "$1" 2>/dev/null || stat -L -f '%Lp' "$1" 2>/dev/null
}

file_size() {
  local size
  size=$(wc -c <"$1" 2>/dev/null) || return 1
  REPLY=$((size))
}

# --- configuration ---------------------------------------------------------

config_path() {
  printf '%s' "${PUSHME_CONFIG:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/pushme/config}"
}

cfg_reset() {
  cfg_backend=
  cfg_ntfy_url=
  cfg_ntfy_topic=
  cfg_ntfy_token=
  cfg_hostname=
  cfg_timeout=
  cfg_curl=
  cfg_ntfy_attach_max=
  cfg_file=
  cfg_file_state=missing
  cfg_unknown=()
  cfg_malformed=()
  cfg_perm_problems=()
}

# Parsed line by line instead of sourced, so a value such as $(...) stays a
# literal string and the file can never run code.
config_read_file() {
  local line key value lineno=0
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line=$(trim "$line")
    case $line in
      '' | '#'*) continue ;;
      *=*) ;;
      *)
        cfg_malformed+=("$lineno")
        continue
        ;;
    esac
    key=$(trim "${line%%=*}")
    value=$(unquote "$(trim "${line#*=}")")
    case $key in
      PUSHME_BACKEND) cfg_backend=$value ;;
      PUSHME_NTFY_URL) cfg_ntfy_url=$value ;;
      PUSHME_NTFY_TOPIC) cfg_ntfy_topic=$value ;;
      PUSHME_NTFY_TOKEN) cfg_ntfy_token=$value ;;
      PUSHME_HOSTNAME) cfg_hostname=$value ;;
      PUSHME_TIMEOUT) cfg_timeout=$value ;;
      PUSHME_NTFY_ATTACH_MAX) cfg_ntfy_attach_max=$value ;;
      *) cfg_unknown+=("$lineno:$key") ;;
    esac
  done <"$1"
}

config_read_env() {
  if [ -n "${PUSHME_BACKEND:-}" ]; then cfg_backend=$PUSHME_BACKEND; fi
  if [ -n "${PUSHME_NTFY_URL:-}" ]; then cfg_ntfy_url=$PUSHME_NTFY_URL; fi
  if [ -n "${PUSHME_NTFY_TOPIC:-}" ]; then cfg_ntfy_topic=$PUSHME_NTFY_TOPIC; fi
  if [ -n "${PUSHME_NTFY_TOKEN:-}" ]; then cfg_ntfy_token=$PUSHME_NTFY_TOKEN; fi
  if [ -n "${PUSHME_HOSTNAME:-}" ]; then cfg_hostname=$PUSHME_HOSTNAME; fi
  if [ -n "${PUSHME_TIMEOUT:-}" ]; then cfg_timeout=$PUSHME_TIMEOUT; fi
  if [ -n "${PUSHME_NTFY_ATTACH_MAX:-}" ]; then cfg_ntfy_attach_max=$PUSHME_NTFY_ATTACH_MAX; fi
  # Environment only: the config file must not choose a program to execute.
  if [ -n "${PUSHME_CURL:-}" ]; then cfg_curl=$PUSHME_CURL; fi
}

config_check_perms() {
  local file=$1 dir mode
  dir=$(dirname "$file")
  mode=$(file_mode "$file")
  case $mode in
    '' | *[!0-7]*) ;;
    *)
      if [ $((8#$mode & 8#077)) -ne 0 ]; then
        cfg_perm_problems+=("設定ファイル $file のパーミッションが $mode です（chmod 600 で他人から読めないようにしてください）")
      fi
      ;;
  esac
  mode=$(file_mode "$dir")
  case $mode in
    '' | *[!0-7]*) ;;
    *)
      if [ $((8#$mode & 8#077)) -ne 0 ]; then
        cfg_perm_problems+=("設定ディレクトリ $dir のパーミッションが $mode です（chmod 700 を推奨）")
      fi
      ;;
  esac
}

# Later sources win: config file < PUSHME_* environment < command-line options.
# An empty value counts as unset everywhere.
load_config() {
  cfg_reset
  cfg_file=$(config_path)
  if [ -f "$cfg_file" ]; then
    if [ -r "$cfg_file" ]; then
      cfg_file_state=ok
      config_read_file "$cfg_file"
    else
      cfg_file_state=unreadable
    fi
    config_check_perms "$cfg_file"
  fi
  config_read_env
  : "${cfg_backend:=ntfy}" "${cfg_ntfy_url:=$NTFY_DEFAULT_URL}" "${cfg_timeout:=10}" "${cfg_curl:=curl}"
  : "${cfg_ntfy_attach_max:=$NTFY_ATTACH_MAX_DEFAULT}"
  while :; do
    case $cfg_ntfy_url in
      */) cfg_ntfy_url=${cfg_ntfy_url%/} ;;
      *) break ;;
    esac
  done
}

config_check_common() {
  case $cfg_backend in
    '' | *[!a-z0-9_]*)
      problem="PUSHME_BACKEND の値が不正です"
      return 1
      ;;
  esac
  if [ "$(type -t "backend_${cfg_backend}_send")" != function ]; then
    problem="PUSHME_BACKEND=$cfg_backend には対応していません（使えるのは ntfy）"
    return 1
  fi
  case $cfg_timeout in
    '' | *[!0-9]*)
      problem="PUSHME_TIMEOUT は 1 以上の整数（秒）にしてください"
      return 1
      ;;
  esac
  if [ $((10#$cfg_timeout)) -lt 1 ]; then
    problem="PUSHME_TIMEOUT は 1 以上の整数（秒）にしてください"
    return 1
  fi
}

# --- HTTP --------------------------------------------------------------------

# Request details reach curl through --config on stdin, not argv, so the topic
# and token never appear in `ps` output.
curl_conf_add() {
  local s=$2 bs=\\ dq='"' nl=$'\n' cr=$'\r' tab=$'\t' vt=$'\v'
  s=${s//"$bs"/"$bs$bs"}
  s=${s//"$dq"/"$bs$dq"}
  s=${s//"$nl"/"${bs}n"}
  s=${s//"$cr"/"${bs}r"}
  s=${s//"$tab"/"${bs}t"}
  s=${s//"$vt"/"${bs}v"}
  curl_conf="$curl_conf$1 = \"$s\"$nl"
}

curl_conf_header() {
  header_value "$2"
  curl_conf_add header "$1: $REPLY"
}

# Sends the request in $curl_conf. Returns 0 when the server accepted it.
curl_send_conf() {
  local marker=__PUSHME_HTTP_STATUS__ attempt=1 res rc status detail
  if ! command -v "$cfg_curl" >/dev/null 2>&1; then
    err "curl が見つかりません（$cfg_curl）"
    return 1
  fi
  while :; do
    res=$(printf '%s' "$curl_conf" | "$cfg_curl" --silent --show-error --fail \
      --connect-timeout 3 --max-time "$cfg_timeout" \
      --output /dev/null --write-out "$marker%{http_code}" --config - 2>&1)
    rc=$?
    # Only a refused connection is retried: the request never reached the
    # server, so it cannot be delivered twice. HTTP 429 in particular is not
    # retried, since ntfy.sh may ban clients that keep exceeding its limits.
    if [ "$rc" -eq 7 ] && [ "$attempt" -lt 2 ]; then
      attempt=$((attempt + 1))
      sleep 1
      continue
    fi
    break
  done
  status=${res##*"$marker"}
  status=${status:0:3}
  case $status in
    [0-9][0-9][0-9]) res=${res/"$marker$status"/} ;;
    *) status=000 ;;
  esac
  if [ "$rc" -eq 0 ]; then
    case $status in
      2??) return 0 ;;
    esac
  fi
  res=$(trim "$(printf '%s' "$res" | tr '\r\n' '  ')")
  case $status in
    429) detail="HTTP 429（ntfy のレート制限に達しました。再試行はしません）" ;;
    3??) detail="HTTP $status（リダイレクト先には送りません。PUSHME_NTFY_URL を確認してください）" ;;
    [45]??) detail="HTTP $status" ;;
    *) detail=${res:-"curl が終了コード $rc で失敗しました"} ;;
  esac
  err "送信に失敗しました: $(redact "$detail")"
  return 1
}

# --- ntfy backend ------------------------------------------------------------
# PUSHME_BACKEND=<name> dispatches to these functions:
#   backend_<name>_validate  check the configuration; on failure set $problem, return 1
#   backend_<name>_send      deliver msg_* (print them when opt_dry_run=1); 0 = sent, 1 = failed
#   backend_<name>_doctor    report checks through doctor_report without sending anything

backend_ntfy_validate() {
  if [ -z "$cfg_ntfy_topic" ]; then
    problem="PUSHME_NTFY_TOPIC が未設定です（pushme init で作成できます）"
    return 1
  fi
  if ! valid_topic "$cfg_ntfy_topic"; then
    problem="PUSHME_NTFY_TOPIC の形式が不正です（$TOPIC_RULE）"
    return 1
  fi
  case $cfg_ntfy_url in
    http://?* | https://?*) ;;
    *)
      problem="PUSHME_NTFY_URL は http:// か https:// で始まる URL にしてください"
      return 1
      ;;
  esac
  case $cfg_ntfy_token in
    *[!\!-~]*)
      problem="PUSHME_NTFY_TOKEN に使えない文字（空白・制御文字・非 ASCII）が含まれています"
      return 1
      ;;
  esac
  case $cfg_ntfy_attach_max in
    '' | *[!0-9]*)
      problem="PUSHME_NTFY_ATTACH_MAX は 0 以上の整数（バイト）にしてください"
      return 1
      ;;
  esac
}

# Drops the caller's tags from the end until the total fits ntfy's limit; the
# host tag is always kept. Sets REPLY.
ntfy_fit_tags() {
  local rest=${1:+$1,} host=$2 tag kept='' total=${#2} dropped=0
  while [ -n "$rest" ]; do
    tag=${rest%%,*}
    rest=${rest#*,}
    if [ "$dropped" -eq 0 ] && [ $((total + ${#tag})) -le "$NTFY_TAGS_MAX" ]; then
      kept=${kept:+$kept,}$tag
      total=$((total + ${#tag}))
    else
      dropped=$((dropped + 1))
    fi
  done
  if [ "$dropped" -gt 0 ]; then
    warn "タグが ntfy の上限（合計 $NTFY_TAGS_MAX バイト）を超えるため、末尾の $dropped 個を送りません"
  fi
  [ -z "$host" ] || kept=${kept:+$kept,}$host
  REPLY=$kept
}

backend_ntfy_send() {
  local url title tags body attach=$msg_attach filename=$msg_filename size=0 method=POST note
  url=$cfg_ntfy_url/$cfg_ntfy_topic
  truncate_utf8 "$msg_title" "$NTFY_TITLE_MAX"
  title=$REPLY
  ntfy_fit_tags "$msg_tags" "$msg_host"
  tags=$REPLY
  body=$msg_body

  if [ -n "$attach" ]; then
    if ! file_size "$attach"; then
      err "添付ファイルを読めません: $attach"
      return 1
    fi
    size=$REPLY
    if [ "$size" -gt "$cfg_ntfy_attach_max" ]; then
      note="添付ファイル $filename（$size バイト）は上限の $cfg_ntfy_attach_max バイトを超えるため送っていません"
      warn "$note"
      body=${body:+$body$'\n\n'}$note
      attach=''
    fi
  fi
  if [ -n "$attach" ]; then
    method=PUT
  elif [ -z "$msg_attach_url" ]; then
    filename=''
  fi
  truncate_utf8 "$body" "$NTFY_BODY_MAX"
  body=$REPLY

  if [ "$opt_dry_run" = 1 ]; then
    printf '%s\n' 'pushme: dry-run（送信していません）'
    printf '%s %s\n' "$method" "$(redact "$url")"
    if [ -n "$title" ]; then printf 'X-Title: %s\n' "$title"; fi
    if [ -n "$msg_priority" ]; then printf 'X-Priority: %s\n' "$msg_priority"; fi
    if [ -n "$tags" ]; then printf 'X-Tags: %s\n' "$tags"; fi
    if [ -n "$msg_click" ]; then printf 'X-Click: %s\n' "$msg_click"; fi
    if [ "$msg_markdown" = 1 ]; then printf 'X-Markdown: yes\n'; fi
    if [ -n "$msg_attach_url" ]; then printf 'X-Attach: %s\n' "$msg_attach_url"; fi
    if [ -n "$filename" ]; then printf 'Filename: %s\n' "$filename"; fi
    if [ -n "$cfg_ntfy_token" ]; then printf 'Authorization: Bearer %s\n' "$(mask "$cfg_ntfy_token")"; fi
    if [ -n "$attach" ]; then
      if [ -n "$body" ]; then printf 'X-Message: %s\n' "$body"; fi
      printf -- '--- 添付ファイル: %s（%d バイト）---\n' "$attach" "$size"
    else
      printf -- '--- 本文（%d バイト）---\n%s\n' "${#body}" "$body"
    fi
    return 0
  fi

  curl_conf=
  curl_conf_add url "$url"
  if [ -n "$title" ]; then curl_conf_header X-Title "$title"; fi
  if [ -n "$msg_priority" ]; then curl_conf_add header "X-Priority: $msg_priority"; fi
  if [ -n "$tags" ]; then curl_conf_header X-Tags "$tags"; fi
  if [ -n "$msg_click" ]; then curl_conf_header X-Click "$msg_click"; fi
  if [ "$msg_markdown" = 1 ]; then curl_conf_add header "X-Markdown: yes"; fi
  if [ -n "$msg_attach_url" ]; then curl_conf_header X-Attach "$msg_attach_url"; fi
  if [ -n "$filename" ]; then curl_conf_header Filename "$filename"; fi
  if [ -n "$cfg_ntfy_token" ]; then curl_conf_add header "Authorization: Bearer $cfg_ntfy_token"; fi
  if [ -n "$attach" ]; then
    # With a PUT upload the request body is the file, so the text moves to a header.
    if [ -n "$body" ]; then curl_conf_header X-Message "$body"; fi
    curl_conf_add upload-file "$attach"
  else
    # data-raw: a body starting with "@" must not be read as a file name.
    curl_conf_add data-raw "$body"
  fi
  curl_send_conf
}

backend_ntfy_doctor() {
  local url_ok=1 res rc
  if [ -z "$cfg_ntfy_topic" ]; then
    doctor_report NG "トピック名: 未設定です（pushme init で作成できます）"
  elif ! valid_topic "$cfg_ntfy_topic"; then
    doctor_report NG "トピック名: 形式が不正です（$TOPIC_RULE）"
  else
    doctor_report OK "トピック名: 設定済み（${#cfg_ntfy_topic} 文字。値は表示しません）"
  fi
  case $cfg_ntfy_url in
    http://?* | https://?*) doctor_report OK "ntfy サーバー: $cfg_ntfy_url" ;;
    *)
      url_ok=0
      doctor_report NG "ntfy サーバー: PUSHME_NTFY_URL は http:// か https:// で始まる URL にしてください"
      ;;
  esac
  if [ -n "$cfg_ntfy_token" ]; then
    case $cfg_ntfy_token in
      *[!\!-~]*) doctor_report NG "アクセストークン: 使えない文字（空白・制御文字・非 ASCII）が含まれています" ;;
      *) doctor_report OK "アクセストークン: 設定済み（${#cfg_ntfy_token} 文字。値は表示しません）" ;;
    esac
  fi
  case $cfg_ntfy_attach_max in
    '' | *[!0-9]*) doctor_report NG "添付の上限: PUSHME_NTFY_ATTACH_MAX は 0 以上の整数（バイト）にしてください" ;;
  esac
  [ "$url_ok" = 1 ] || return 0
  if ! command -v "$cfg_curl" >/dev/null 2>&1; then
    doctor_report NG "疎通: curl がないため確認できません"
    return 0
  fi
  # /v1/health answers without publishing, so the check does not use up the
  # daily message quota.
  res=$("$cfg_curl" --silent --show-error --fail --connect-timeout 3 \
    --max-time "$cfg_timeout" "$cfg_ntfy_url/v1/health" 2>&1)
  rc=$?
  case $rc:$res in
    0:*'"healthy":true'* | 0:*'"healthy": true'*)
      doctor_report OK "疎通: $cfg_ntfy_url/v1/health に接続できました（通知は送っていません）"
      ;;
    0:*) doctor_report NG "疎通: $cfg_ntfy_url/v1/health が healthy を返しませんでした" ;;
    *) doctor_report NG "疎通: $cfg_ntfy_url/v1/health に接続できません: $(trim "$(printf '%s' "$res" | tr '\r\n' '  ')")" ;;
  esac
}

# --- options shared by send and run ---------------------------------------

reset_message_options() {
  opt_title=''
  opt_priority=''
  opt_priority_set=0
  opt_tags=''
  opt_click=''
  opt_attach=''
  opt_attach_set=0
  opt_filename=''
  opt_attach_url=''
  opt_markdown=0
  opt_no_host=0
  opt_quiet=0
  opt_dry_run=0
}

value_option() {
  case $1 in
    -t | --title | -p | --priority | -T | --tags | -c | --click | -a | --attach | \
      --filename | --attach-url | --tail)
      return 0
      ;;
  esac
  return 1
}

# Consumes one option shared by send and run. OPT_SHIFT is the number of
# arguments used, 0 when $1 is not one of them.
parse_message_option() {
  OPT_SHIFT=1
  if value_option "$1"; then
    [ $# -ge 2 ] || die "$EX_USAGE" "$1 には値が必要です"
    OPT_SHIFT=2
  fi
  case $1 in
    -t | --title) opt_title=$2 ;;
    -p | --priority) opt_priority=$2 opt_priority_set=1 ;;
    -T | --tags) opt_tags=${opt_tags:+$opt_tags,}$2 ;;
    -c | --click) opt_click=$2 ;;
    -a | --attach) opt_attach=$2 opt_attach_set=1 ;;
    --filename) opt_filename=$2 ;;
    --attach-url) opt_attach_url=$2 ;;
    --markdown) opt_markdown=1 ;;
    --no-host) opt_no_host=1 ;;
    -q | --quiet) opt_quiet=1 ;;
    --dry-run) opt_dry_run=1 ;;
    *) OPT_SHIFT=0 ;;
  esac
}

# Checks the shared options and copies them into msg_*.
prepare_message() {
  msg_priority=''
  if [ "$opt_priority_set" = 1 ]; then
    normalize_priority "$opt_priority" ||
      die "$EX_USAGE" "優先度の値が不正です: $opt_priority（1〜5 または min / low / default / high / urgent）"
    msg_priority=$REPLY
  fi
  if [ "$opt_attach_set" = 1 ] && [ -n "$opt_attach_url" ]; then
    die "$EX_USAGE" "--attach と --attach-url は同時に指定できません"
  fi
  if [ -n "$opt_filename" ] && [ "$opt_attach_set" = 0 ] && [ -z "$opt_attach_url" ]; then
    die "$EX_USAGE" "--filename は --attach か --attach-url と一緒に指定してください"
  fi
  normalize_tags "$opt_tags"
  msg_tags=$REPLY
  msg_title=$opt_title
  msg_click=$opt_click
  msg_markdown=$opt_markdown
  msg_attach=$opt_attach
  msg_attach_url=$opt_attach_url
  msg_filename=$opt_filename
  if [ "$opt_attach_set" = 1 ] && [ -z "$msg_filename" ]; then
    msg_filename=${opt_attach##*/}
  fi
  msg_body=''
}

# Loads the configuration and checks that a notification can be sent. On
# failure sets $problem and returns 1.
load_valid_config() {
  local p
  load_config
  for p in ${cfg_perm_problems[@]+"${cfg_perm_problems[@]}"}; do
    warn "$p"
  done
  if [ "$cfg_file_state" = unreadable ]; then
    problem="設定ファイルを読めません: $cfg_file"
    return 1
  fi
  config_check_common && "backend_${cfg_backend}_validate"
}

set_message_host() {
  if [ "$opt_no_host" = 1 ]; then
    msg_host=''
  else
    msg_host=${cfg_hostname:-$(default_hostname)}
  fi
}

attachment_readable() {
  [ -f "$1" ] && [ -r "$1" ]
}

# --- commands --------------------------------------------------------------

cmd_send() {
  local args body
  reset_message_options
  while [ $# -gt 0 ]; do
    case $1 in
      --?*=*)
        if value_option "${1%%=*}"; then
          set -- "${1%%=*}" "${1#*=}" "${@:2}"
          continue
        fi
        ;;
    esac
    parse_message_option "$@"
    if [ "$OPT_SHIFT" -gt 0 ]; then
      shift "$OPT_SHIFT"
      continue
    fi
    case $1 in
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -) break ;;
      -?*) die "$EX_USAGE" "不明なオプションです: $1（pushme help を参照）" ;;
      *) break ;;
    esac
  done
  args=("$@")

  prepare_message
  load_valid_config || die "$EX_USAGE" "$problem"
  set_message_host

  if [ ${#args[@]} -eq 1 ] && [ "${args[0]}" = - ]; then
    body=$(cat)
  elif [ ${#args[@]} -gt 0 ]; then
    join_words "${args[@]}"
    body=$REPLY
  elif [ ! -t 0 ]; then
    body=$(cat)
  else
    body=
  fi
  if is_blank "$body"; then
    if [ "$opt_attach_set" = 0 ] && [ -z "$msg_attach_url" ]; then
      die "$EX_USAGE" "本文が空です（引数か標準入力で渡してください）"
    fi
    body=''
  fi
  msg_body=$body
  if [ "$opt_attach_set" = 1 ] && ! attachment_readable "$msg_attach"; then
    die "$EX_USAGE" "添付ファイルを読めません: $msg_attach"
  fi

  "backend_${cfg_backend}_send" || exit "$EX_FAIL"
  if [ "$opt_dry_run" != 1 ] && [ "$opt_quiet" != 1 ]; then
    printf '%s\n' 'pushme: 送信しました'
  fi
}

# Runs an external program only, never one of pushme's functions or a
# builtin such as exit.
run_command() {
  case $1 in
    */*)
      if [ ! -e "$1" ]; then
        printf 'pushme: %s: ファイルがありません\n' "$1" >&2
        return 127
      fi
      ;;
    *)
      if ! type -P "$1" >/dev/null; then
        printf 'pushme: %s: コマンドが見つかりません\n' "$1" >&2
        return 127
      fi
      ;;
  esac
  (exec "$@")
}

# Fills msg_* for a finished command. Arguments: exit code, seconds taken,
# --tail line count, captured output, then the command itself.
run_build_message() {
  local rc=$1 elapsed=$2 lines=$3 output=$4 nl=$'\n' name tag exit_text signame
  local command_line section budget
  shift 4
  name=${1##*/}
  if [ "$rc" -eq 0 ]; then
    tag=white_check_mark
    : "${msg_title:=$name 成功}"
  else
    tag=x
    : "${msg_title:=$name 失敗 (exit $rc)}"
  fi
  : "${msg_priority:=4}"
  msg_tags=$tag${msg_tags:+,$msg_tags}

  exit_text=$rc
  if [ "$rc" -gt 128 ] && signame=$(kill -l $((rc - 128)) 2>/dev/null); then
    exit_text="$rc（SIG$signame）"
  fi
  format_command_line "$@"
  truncate_utf8 "$REPLY" 300
  command_line=$REPLY
  format_duration "$elapsed"
  msg_body="\$ $command_line${nl}終了コード: $exit_text${nl}所要時間: $REPLY"
  if [ -n "$output" ]; then
    section="${nl}--- 出力の末尾 $lines 行 ---${nl}"
    budget=$((NTFY_BODY_MAX - ${#msg_body} - ${#section}))
    if [ "$budget" -gt 3 ]; then
      keep_tail_utf8 "$output" "$budget"
      msg_body=$msg_body$section$REPLY
    fi
  fi

  # The file may be one the command was supposed to write, so a missing one
  # only drops the attachment instead of losing the notification.
  if [ "$opt_attach_set" = 1 ] && ! attachment_readable "$msg_attach"; then
    warn "添付ファイルを読めないため、添付せずに送ります: $msg_attach"
    msg_attach=''
    msg_filename=''
  fi
  set_message_host
}

# Exits with the command's status. When pushme itself received the signal
# that ended the command, it dies by that signal instead, so a calling shell
# notices the interruption (a script loop stops on Ctrl-C).
run_exit() {
  local rc=$1 num=''
  case $run_signal in
    HUP) num=1 ;;
    INT) num=2 ;;
    TERM) num=15 ;;
  esac
  if [ -n "$num" ] && [ "$rc" -eq $((128 + num)) ]; then
    trap - "$run_signal"
    kill -s "$run_signal" "$$"
  fi
  exit "$rc"
}

cmd_run() {
  local on_fail_only=0 tail_set=0 tail_lines='' separator=0 can_notify=1
  local rc start elapsed tmp='' output=''
  reset_message_options
  while [ $# -gt 0 ]; do
    case $1 in
      --?*=*)
        if value_option "${1%%=*}"; then
          set -- "${1%%=*}" "${1#*=}" "${@:2}"
          continue
        fi
        ;;
    esac
    parse_message_option "$@"
    if [ "$OPT_SHIFT" -gt 0 ]; then
      shift "$OPT_SHIFT"
      continue
    fi
    case $1 in
      --on-fail-only) on_fail_only=1 ;;
      --tail)
        tail_set=1
        tail_lines=$2
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        separator=1
        break
        ;;
      -?*) die "$EX_USAGE" "不明なオプションです: $1（pushme help を参照）" ;;
      *) break ;;
    esac
    shift
  done
  if [ "$separator" = 0 ] || [ $# -eq 0 ]; then
    die "$EX_USAGE" "実行するコマンドを -- の後に書いてください（pushme run [オプション] -- コマンド [引数...]）"
  fi
  if [ "$tail_set" = 1 ]; then
    case $tail_lines in
      '' | *[!0-9]*) die "$EX_USAGE" "--tail には 1 以上の整数を指定してください" ;;
    esac
    [ $((10#$tail_lines)) -ge 1 ] || die "$EX_USAGE" "--tail には 1 以上の整数を指定してください"
  fi
  prepare_message
  # Reported before the command starts, so a long job does not run on with a
  # notification that can never arrive.
  if ! load_valid_config; then
    err "通知は送れません（コマンドはそのまま実行します）: $problem"
    can_notify=0
  fi

  # The command runs in the foreground: a background job of a non-interactive
  # bash starts with SIGINT ignored, and bash 3.2 cannot undo that, so Ctrl-C
  # would no longer stop it. Ctrl-C reaches the whole foreground process group,
  # so the command gets it directly; the traps only keep pushme alive to notify.
  run_signal=''
  trap 'run_signal=INT' INT
  trap 'run_signal=TERM' TERM
  trap 'run_signal=HUP' HUP
  if [ "$tail_set" = 1 ]; then
    tmp=$(mktemp "${TMPDIR:-/tmp}/pushme-run.XXXXXX") ||
      warn "一時ファイルを作れないため、--tail の出力は通知に含めません"
  fi
  start=$SECONDS
  if [ -n "$tmp" ]; then
    run_command "$@" 2>&1 | tee "$tmp"
    rc=${PIPESTATUS[0]}
    output=$(tail -n "$tail_lines" "$tmp")
    rm -f "$tmp"
  else
    run_command "$@"
    rc=$?
  fi
  elapsed=$((SECONDS - start))

  if [ "$rc" -eq 0 ] && [ "$on_fail_only" = 1 ]; then
    run_exit "$rc"
  fi
  if [ "$can_notify" = 1 ]; then
    run_build_message "$rc" "$elapsed" "$tail_lines" "$output" "$@"
    # stdout belongs to the command, so pushme's own report goes to stderr.
    if "backend_${cfg_backend}_send" && [ "$opt_dry_run" != 1 ] && [ "$opt_quiet" != 1 ]; then
      printf '%s\n' 'pushme: 通知を送りました' >&2
    fi
  fi
  run_exit "$rc"
}

generate_topic() {
  local rand
  rand=$(tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 59)
  [ "${#rand}" -eq 59 ] || return 1
  printf 'ntfy-%s' "$rand"
}

config_template() {
  cat <<EOF
# pushme の設定ファイル（KEY=VALUE 形式。シェルスクリプトとしては実行されない）
# トピック名はパスワードと同じように扱うこと
PUSHME_NTFY_TOPIC=$1

# PUSHME_NTFY_URL=$NTFY_DEFAULT_URL
# PUSHME_NTFY_TOKEN=
# PUSHME_HOSTNAME=
# PUSHME_TIMEOUT=10
EOF
}

# Sets modes explicitly rather than trusting the caller's umask.
write_config() {
  local file=$1 topic=$2 dir tmp
  dir=$(dirname "$file")
  if [ ! -d "$dir" ]; then
    mkdir -p "$dir" || return 1
    chmod 700 "$dir" || return 1
  fi
  tmp=$file.tmp.$$
  (umask 077 && : >"$tmp") || return 1
  if ! chmod 600 "$tmp" || ! config_template "$topic" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$file" && chmod 600 "$file"
}

cmd_init() {
  local force=0 ask_test=1 file topic='' answer generated=0
  while [ $# -gt 0 ]; do
    case $1 in
      --force) force=1 ;;
      --no-test) ask_test=0 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "$EX_USAGE" "init に不明な引数があります: $1（トピック名は引数ではなく標準入力から渡してください）" ;;
    esac
    shift
  done

  file=$(config_path)
  if [ -e "$file" ] && [ "$force" = 0 ]; then
    printf 'pushme: 設定ファイルは既にあります: %s（作り直すには pushme init --force）\n' "$file"
    return 0
  fi

  # The topic is read from stdin only, never from argv, so it stays out of
  # shell history.
  if [ -t 0 ]; then
    printf '既存のトピック名を貼り付けて Enter（空のまま Enter で新規生成）: ' >&2
    IFS= read -r -s topic || :
    printf '\n' >&2
  else
    IFS= read -r topic || :
  fi
  topic=$(trim "$topic")

  if [ -z "$topic" ]; then
    topic=$(generate_topic) || die "$EX_FAIL" "トピック名を生成できませんでした（/dev/urandom を読めません）"
    generated=1
  elif ! valid_topic "$topic"; then
    die "$EX_USAGE" "トピック名の形式が不正です（$TOPIC_RULE）"
  fi

  write_config "$file" "$topic" || die "$EX_FAIL" "設定ファイルを書き込めませんでした: $file"
  printf '設定ファイルを作成しました: %s\n' "$file"
  load_config

  if [ "$generated" = 1 ]; then
    cat <<EOF

新しいトピック名を生成しました。表示するのはこの 1 回だけです。
パスワード管理ツールに保存してください（知っている人は誰でも通知を送れて、読めます）。

  $topic

Android 側の準備:
  1. ntfy アプリを入れる（Google Play または F-Droid）
  2. アプリの「+」から購読を追加し、「トピック名」に上の文字列を貼り付ける
EOF
    if [ "$cfg_ntfy_url" = "$NTFY_DEFAULT_URL" ]; then
      printf '  3. 「別のサーバーを使う」はオフのまま「購読」を押す\n'
    else
      printf '  3. 「別のサーバーを使う」をオンにして %s を入力し、「購読」を押す\n' "$cfg_ntfy_url"
    fi
  else
    printf 'トピック名を取り込みました（値は表示しません）。\n'
  fi

  if [ "$ask_test" = 1 ] && [ -t 0 ]; then
    printf '\nテスト通知を 1 通送りますか？ [y/N]: ' >&2
    IFS= read -r answer || answer=
    case $answer in
      y | Y | yes | YES) cmd_send --title pushme -- 'pushme init からのテスト通知です' ;;
    esac
  fi
}

doctor_report() {
  printf '[%s] %s\n' "$1" "$2"
  if [ "$1" = NG ]; then doctor_ng=$((doctor_ng + 1)); fi
}

cmd_doctor() {
  local path item
  case ${1:-} in
    '') ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die "$EX_USAGE" "doctor に不明な引数があります: $1" ;;
  esac
  doctor_ng=0
  load_config

  if path=$(command -v "$cfg_curl"); then
    doctor_report OK "curl: $path"
  else
    doctor_report NG "curl: 見つかりません（必須）"
  fi
  if path=$(command -v jq); then
    doctor_report OK "jq: $path（Claude Code の hook を使うなら必要）"
  else
    doctor_report -- "jq: 見つかりません（任意。Claude Code の hook を使うなら必要）"
  fi

  case $cfg_file_state in
    ok) doctor_report OK "設定ファイル: $cfg_file" ;;
    unreadable) doctor_report NG "設定ファイル: 読めません: $cfg_file" ;;
    missing) doctor_report -- "設定ファイル: ありません: $cfg_file（pushme init で作成できます）" ;;
  esac
  for item in ${cfg_perm_problems[@]+"${cfg_perm_problems[@]}"}; do
    doctor_report NG "$item"
  done
  for item in ${cfg_unknown[@]+"${cfg_unknown[@]}"}; do
    doctor_report '!!' "設定ファイル ${item%%:*} 行目: 未知のキー ${item#*:} は無視されます"
  done
  for item in ${cfg_malformed[@]+"${cfg_malformed[@]}"}; do
    doctor_report '!!' "設定ファイル $item 行目: KEY=VALUE の形式ではないため無視されます"
  done

  if config_check_common; then
    "backend_${cfg_backend}_doctor"
  else
    doctor_report NG "$problem"
  fi

  if [ "$doctor_ng" -gt 0 ]; then
    printf '問題が %d 件あります\n' "$doctor_ng"
    exit "$EX_FAIL"
  fi
  printf '問題は見つかりませんでした\n'
}

main() {
  cfg_reset
  case ${1:-} in
    send)
      shift
      cmd_send "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    doctor)
      shift
      cmd_doctor "$@"
      ;;
    help | -h | --help) usage ;;
    version | --version) printf 'pushme %s\n' "$PUSHME_VERSION" ;;
    *) cmd_send "$@" ;;
  esac
}

# Sourcing the file, as the tests do, defines the functions without running main.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
