#!/usr/bin/env bash
# pushme: send push notifications to your phone through ntfy.
# Must keep running on bash 3.2 (macOS /bin/bash): no associative arrays,
# ${var,,}, mapfile or namerefs.

set -u

# Byte semantics for ${#var}, substring slicing and [A-Z] ranges. The caller's
# value is kept so that `pushme run` can hand it back to the command.
caller_lc_all=${LC_ALL-}
caller_lc_all_set=${LC_ALL+1}
export LC_ALL=C

PUSHME_VERSION=0.1.0
EX_FAIL=1
EX_USAGE=2
ERROR_LOG_MAX=102400
NTFY_DEFAULT_URL=https://ntfy.sh
# ntfy delivers a body over 4,096 bytes as a file attachment instead of
# notification text.
NTFY_BODY_MAX=4000
# ntfy rejects a title over 1 KB, or tags over 512 bytes in total, with HTTP 400.
NTFY_TITLE_MAX=1000
NTFY_TAGS_MAX=512
# The attachment size limit of the ntfy.sh free tier.
NTFY_ATTACH_MAX_DEFAULT=2097152
# ntfy.sh keeps an attachment for 3 hours and refuses one that would expire
# before its delayed message is delivered. It also refuses a delay under 10
# seconds by its own clock, so the shortest one sent leaves some room.
NTFY_ATTACH_EXPIRY=10800
NTFY_DELAY_MIN=15
PUSHOVER_API=https://api.pushover.net/1
# Pushover's limits are in characters; cutting to as many bytes keeps the
# character count under them too.
PUSHOVER_MESSAGE_MAX=1024
PUSHOVER_TITLE_MAX=250
PUSHOVER_ATTACH_MAX=5242880
TOPIC_RULE='英数字・「-」・「_」の 1〜64 文字'

usage() {
  cat <<'EOF'
pushme — スマートフォンにプッシュ通知を送る（ntfy）

使い方:
  pushme [send] [オプション] [メッセージ...]
  pushme run [オプション] [--on-fail-only] [--tail N] -- コマンド [引数...]
  pushme init [--force] [--no-test]
  pushme doctor
  pushme claude-hook [--dry-run]
  pushme codex-hook [--dry-run]
  pushme help | version

send と run のオプション:
  -t, --title TEXT       タイトル
  -p, --priority VALUE   優先度。1〜5 または min / low / default / high / urgent
  -T, --tags a,b         タグ（カンマ区切り。繰り返し指定できる）。末尾にホスト名タグが付く
  -c, --click URL        通知をタップしたときに開く URL
  -a, --attach FILE      ファイルを添付する
      --filename NAME    添付ファイルの表示名（既定はファイル名）
      --attach-url URL   外部の URL を添付する
      --markdown         本文を Markdown として表示する
      --no-host          ホスト名タグを付けない
  -q, --quiet            成功時に何も表示しない（cron ではメールが届かないよう付ける）
      --dry-run          送信せず、送る内容を表示する（トピック名とトークンは伏せ字）
      --ignore-dnd       DnD の時間帯（PUSHME_DND）でも送る

send:
  引数を空白でつないで本文にする。引数がなく標準入力が端末でなければ標準入力を読む。
  「-」だけを指定したときも標準入力を読む。「--」以降の引数はすべてメッセージになる。
  4,000 バイトを超える本文は切り詰める。

run:
  コマンドを実行し、終わったら成否・終了コード・所要時間を通知する。
  終了コードはコマンドの終了コードそのまま（通知に失敗しても変わらない）。
  --on-fail-only   終了コードが 0 のときは通知しない
  --tail N         出力の末尾 N 行を本文に含める（標準エラーは標準出力に合流する）

init のオプション:
  --force     既存の設定ファイルを作り直す
  --no-test   最後にテスト通知を送るか尋ねない

claude-hook / codex-hook:
  Claude Code / Codex の hook から呼ばれ、標準入力の JSON を読んで通知する（jq が必要）。
  常に終了コード 0 で終わり、標準出力には何も出さない。
  --dry-run   送信せず、送る内容を標準エラー出力に表示する

終了コード: 0 = 成功、1 = 送信の失敗、2 = 使い方の誤り・設定の不足（run を除く）
設定ファイル: ~/.config/pushme/config（XDG_CONFIG_HOME や PUSHME_CONFIG で変更できる）
EOF
}

# --- output and logging ---------------------------------------------------

warn() { printf 'pushme: 警告: %s\n' "$1" >&2; }

# Errors are also logged because pushme usually runs where stderr is thrown
# away (cron jobs, editor hooks).
err() {
  printf 'pushme: エラー: %s\n' "$1" >&2
  log_error "$1"
}

die() {
  err "$2"
  exit "$1"
}

log_error() {
  local dir file size
  dir=${XDG_STATE_HOME:-${HOME:-}/.local/state}/pushme
  file=$dir/error.log
  {
    if [ ! -d "$dir" ]; then
      mkdir -p "$dir" && chmod 700 "$dir"
    fi
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" >>"$file"
    size=$(wc -c <"$file")
    if [ "$size" -gt "$ERROR_LOG_MAX" ]; then
      tail -c $((ERROR_LOG_MAX / 2)) "$file" | {
        IFS= read -r _
        cat
      } >"$file.tmp" && mv -f "$file.tmp" "$file"
    fi
  } 2>/dev/null
  return 0
}

# Shows a few leading characters of a secret and its length, never the rest.
mask() {
  local s=$1 keep
  keep=$((${#s} / 8))
  [ "$keep" -le 7 ] || keep=7
  printf '%s…(%d chars)' "${s:0:keep}" "${#s}"
}

redact() {
  local s=$1 secret masked
  for secret in "$cfg_ntfy_topic" "$cfg_ntfy_token" "$cfg_pushover_token" "$cfg_pushover_user"; do
    [ -n "$secret" ] || continue
    masked=$(mask "$secret")
    s=${s//"$secret"/"$masked"}
  done
  printf '%s' "$s"
}

# --- small helpers ---------------------------------------------------------

trim() {
  local s=$1
  s=${s#"${s%%[![:space:]]*}"}
  s=${s%"${s##*[![:space:]]}"}
  printf '%s' "$s"
}

unquote() {
  local s=$1
  case $s in
    \"*\" | \'*\') s=${s:1:${#s}-2} ;;
  esac
  printf '%s' "$s"
}

join_words() {
  local IFS=' '
  REPLY="$*"
}

is_blank() {
  case $1 in
    *[![:space:]]*) return 1 ;;
  esac
  return 0
}

valid_topic() {
  case $1 in
    '' | *[!A-Za-z0-9_-]*) return 1 ;;
  esac
  [ "${#1}" -le 64 ]
}

normalize_priority() {
  case $(printf '%s' "$1" | tr '[:upper:]' '[:lower:]') in
    1 | min) REPLY=1 ;;
    2 | low) REPLY=2 ;;
    3 | default) REPLY=3 ;;
    4 | high) REPLY=4 ;;
    5 | urgent | max) REPLY=5 ;;
    *) return 1 ;;
  esac
}

# Splits on commas, trims each tag and drops empty ones.
normalize_tags() {
  local rest=$1, tag out=''
  while [ -n "$rest" ]; do
    tag=$(trim "${rest%%,*}")
    rest=${rest#*,}
    [ -n "$tag" ] && out=${out:+$out,}$tag
  done
  REPLY=$out
}

# Cuts $1 to at most $2 bytes including a trailing "…", without splitting a
# UTF-8 sequence. Pure bash because head -c and iconv differ between macOS
# and Linux.
truncate_utf8() {
  local s=$1 max=$2 ellipsis=$'\xe2\x80\xa6' n i need
  if [ "${#s}" -le "$max" ]; then
    REPLY=$s
    return
  fi
  s=${s:0:max-${#ellipsis}}
  n=${#s}
  i=$((n - 1))
  while [ "$i" -gt 0 ] && [ $((n - i)) -le 3 ]; do
    case ${s:i:1} in
      [$'\x80'-$'\xbf']) i=$((i - 1)) ;;
      *) break ;;
    esac
  done
  case ${s:i:1} in
    [$'\xc0'-$'\xdf']) need=2 ;;
    [$'\xe0'-$'\xef']) need=3 ;;
    [$'\xf0'-$'\xf7']) need=4 ;;
    *) need=1 ;;
  esac
  [ $((n - i)) -ge "$need" ] || s=${s:0:i}
  REPLY=$s$ellipsis
}

# Keeps the last $2 bytes of $1 behind a leading "…", starting on a UTF-8
# character boundary.
keep_tail_utf8() {
  local s=$1 max=$2 ellipsis=$'\xe2\x80\xa6' k=0
  if [ "${#s}" -le "$max" ]; then
    REPLY=$s
    return
  fi
  s=${s:$((${#s} - max + ${#ellipsis}))}
  while [ "$k" -lt 3 ]; do
    case ${s:0:1} in
      [$'\x80'-$'\xbf']) s=${s:1} ;;
      *) break ;;
    esac
    k=$((k + 1))
  done
  REPLY=$ellipsis$s
}

format_duration() {
  local h m s=$1
  h=$((s / 3600))
  m=$((s % 3600 / 60))
  s=$((s % 60))
  if [ "$h" -gt 0 ]; then
    REPLY=${h}h${m}m${s}s
  elif [ "$m" -gt 0 ]; then
    REPLY=${m}m${s}s
  else
    REPLY=${s}s
  fi
}

# Quotes words that contain whitespace or quotes, so the command line in a
# notification reads unambiguously.
format_command_line() {
  local arg escaped out='' q="'" q_escaped="'\\''"
  for arg in "$@"; do
    case $arg in
      '' | *[[:space:]]* | *"$q"*)
        escaped=${arg//"$q"/"$q_escaped"}
        arg="'$escaped'"
        ;;
    esac
    out=${out:+$out }$arg
  done
  REPLY=$out
}

# Some HTTP stacks mangle raw UTF-8 in headers, and ntfy decodes RFC 2047
# encoded-words in every header (https://docs.ntfy.sh/publish/#list-of-all-parameters).
# Values containing "=?" are encoded too, or the server would decode them.
header_value() {
  case $1 in
    *[!\ -~]* | *'=?'*)
      REPLY="=?UTF-8?B?$(printf '%s' "$1" | base64 | tr -d '\n')?="
      ;;
    *) REPLY=$1 ;;
  esac
}

default_hostname() {
  local h
  h=$(hostname -s 2>/dev/null) || h=
  [ -n "$h" ] || h=$(uname -n 2>/dev/null)
  printf '%s' "${h%%.*}"
}

file_mode() {
  stat -L -c '%a' "$1" 2>/dev/null || stat -L -f '%Lp' "$1" 2>/dev/null
}

file_size() {
  local size
  size=$(wc -c <"$1" 2>/dev/null) || return 1
  REPLY=$((size))
}

# --- configuration ---------------------------------------------------------

config_path() {
  printf '%s' "${PUSHME_CONFIG:-${XDG_CONFIG_HOME:-${HOME:-}/.config}/pushme/config}"
}

cfg_reset() {
  cfg_backend=
  cfg_ntfy_url=
  cfg_ntfy_topic=
  cfg_ntfy_token=
  cfg_hostname=
  cfg_timeout=
  cfg_curl=
  cfg_ntfy_attach_max=
  cfg_claude_min_seconds=
  cfg_claude_include_message=
  cfg_claude_include_command=
  cfg_claude_delay_seconds=
  cfg_codex_min_seconds=
  cfg_codex_include_message=
  cfg_codex_notify_permission=
  cfg_codex_delay_seconds=
  cfg_dnd=
  cfg_dnd_mode=
  cfg_dnd_tz=
  cfg_pushover_token=
  cfg_pushover_user=
  cfg_pushover_device=
  cfg_file=
  cfg_file_state=missing
  cfg_unknown=()
  cfg_malformed=()
  cfg_perm_problems=()
}

# Parsed line by line instead of sourced, so a value such as $(...) stays a
# literal string and the file can never run code.
config_read_file() {
  local line key value lineno=0
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    line=$(trim "$line")
    case $line in
      '' | '#'*) continue ;;
      *=*) ;;
      *)
        cfg_malformed+=("$lineno")
        continue
        ;;
    esac
    key=$(trim "${line%%=*}")
    value=$(unquote "$(trim "${line#*=}")")
    case $key in
      PUSHME_BACKEND) cfg_backend=$value ;;
      PUSHME_NTFY_URL) cfg_ntfy_url=$value ;;
      PUSHME_NTFY_TOPIC) cfg_ntfy_topic=$value ;;
      PUSHME_NTFY_TOKEN) cfg_ntfy_token=$value ;;
      PUSHME_HOSTNAME) cfg_hostname=$value ;;
      PUSHME_TIMEOUT) cfg_timeout=$value ;;
      PUSHME_NTFY_ATTACH_MAX) cfg_ntfy_attach_max=$value ;;
      PUSHME_CLAUDE_MIN_SECONDS) cfg_claude_min_seconds=$value ;;
      PUSHME_CLAUDE_INCLUDE_MESSAGE) cfg_claude_include_message=$value ;;
      PUSHME_CLAUDE_INCLUDE_COMMAND) cfg_claude_include_command=$value ;;
      PUSHME_CLAUDE_DELAY_SECONDS) cfg_claude_delay_seconds=$value ;;
      PUSHME_CODEX_MIN_SECONDS) cfg_codex_min_seconds=$value ;;
      PUSHME_CODEX_INCLUDE_MESSAGE) cfg_codex_include_message=$value ;;
      PUSHME_CODEX_NOTIFY_PERMISSION) cfg_codex_notify_permission=$value ;;
      PUSHME_CODEX_DELAY_SECONDS) cfg_codex_delay_seconds=$value ;;
      PUSHME_DND) cfg_dnd=$value ;;
      PUSHME_DND_MODE) cfg_dnd_mode=$value ;;
      PUSHME_DND_TZ) cfg_dnd_tz=$value ;;
      PUSHME_PUSHOVER_TOKEN) cfg_pushover_token=$value ;;
      PUSHME_PUSHOVER_USER) cfg_pushover_user=$value ;;
      PUSHME_PUSHOVER_DEVICE) cfg_pushover_device=$value ;;
      *) cfg_unknown+=("$lineno:$key") ;;
    esac
  done <"$1"
}

config_read_env() {
  if [ -n "${PUSHME_BACKEND:-}" ]; then cfg_backend=$PUSHME_BACKEND; fi
  if [ -n "${PUSHME_NTFY_URL:-}" ]; then cfg_ntfy_url=$PUSHME_NTFY_URL; fi
  if [ -n "${PUSHME_NTFY_TOPIC:-}" ]; then cfg_ntfy_topic=$PUSHME_NTFY_TOPIC; fi
  if [ -n "${PUSHME_NTFY_TOKEN:-}" ]; then cfg_ntfy_token=$PUSHME_NTFY_TOKEN; fi
  if [ -n "${PUSHME_HOSTNAME:-}" ]; then cfg_hostname=$PUSHME_HOSTNAME; fi
  if [ -n "${PUSHME_TIMEOUT:-}" ]; then cfg_timeout=$PUSHME_TIMEOUT; fi
  if [ -n "${PUSHME_NTFY_ATTACH_MAX:-}" ]; then cfg_ntfy_attach_max=$PUSHME_NTFY_ATTACH_MAX; fi
  if [ -n "${PUSHME_CLAUDE_MIN_SECONDS:-}" ]; then cfg_claude_min_seconds=$PUSHME_CLAUDE_MIN_SECONDS; fi
  if [ -n "${PUSHME_CLAUDE_INCLUDE_MESSAGE:-}" ]; then cfg_claude_include_message=$PUSHME_CLAUDE_INCLUDE_MESSAGE; fi
  if [ -n "${PUSHME_CLAUDE_INCLUDE_COMMAND:-}" ]; then cfg_claude_include_command=$PUSHME_CLAUDE_INCLUDE_COMMAND; fi
  if [ -n "${PUSHME_CLAUDE_DELAY_SECONDS:-}" ]; then cfg_claude_delay_seconds=$PUSHME_CLAUDE_DELAY_SECONDS; fi
  if [ -n "${PUSHME_CODEX_MIN_SECONDS:-}" ]; then cfg_codex_min_seconds=$PUSHME_CODEX_MIN_SECONDS; fi
  if [ -n "${PUSHME_CODEX_INCLUDE_MESSAGE:-}" ]; then cfg_codex_include_message=$PUSHME_CODEX_INCLUDE_MESSAGE; fi
  if [ -n "${PUSHME_CODEX_NOTIFY_PERMISSION:-}" ]; then cfg_codex_notify_permission=$PUSHME_CODEX_NOTIFY_PERMISSION; fi
  if [ -n "${PUSHME_CODEX_DELAY_SECONDS:-}" ]; then cfg_codex_delay_seconds=$PUSHME_CODEX_DELAY_SECONDS; fi
  if [ -n "${PUSHME_DND:-}" ]; then cfg_dnd=$PUSHME_DND; fi
  if [ -n "${PUSHME_DND_MODE:-}" ]; then cfg_dnd_mode=$PUSHME_DND_MODE; fi
  if [ -n "${PUSHME_DND_TZ:-}" ]; then cfg_dnd_tz=$PUSHME_DND_TZ; fi
  if [ -n "${PUSHME_PUSHOVER_TOKEN:-}" ]; then cfg_pushover_token=$PUSHME_PUSHOVER_TOKEN; fi
  if [ -n "${PUSHME_PUSHOVER_USER:-}" ]; then cfg_pushover_user=$PUSHME_PUSHOVER_USER; fi
  if [ -n "${PUSHME_PUSHOVER_DEVICE:-}" ]; then cfg_pushover_device=$PUSHME_PUSHOVER_DEVICE; fi
  # Environment only: the config file must not choose a program to execute.
  if [ -n "${PUSHME_CURL:-}" ]; then cfg_curl=$PUSHME_CURL; fi
}

config_check_perms() {
  local file=$1 dir mode
  dir=$(dirname "$file")
  mode=$(file_mode "$file")
  case $mode in
    '' | *[!0-7]*) ;;
    *)
      if [ $((8#$mode & 8#077)) -ne 0 ]; then
        cfg_perm_problems+=("設定ファイル $file のパーミッションが $mode です（chmod 600 で他人から読めないようにしてください）")
      fi
      ;;
  esac
  mode=$(file_mode "$dir")
  case $mode in
    '' | *[!0-7]*) ;;
    *)
      if [ $((8#$mode & 8#077)) -ne 0 ]; then
        cfg_perm_problems+=("設定ディレクトリ $dir のパーミッションが $mode です（chmod 700 を推奨）")
      fi
      ;;
  esac
}

# Later sources win: config file < PUSHME_* environment < command-line options.
# An empty value counts as unset everywhere.
load_config() {
  cfg_reset
  cfg_file=$(config_path)
  if [ -f "$cfg_file" ]; then
    if [ -r "$cfg_file" ]; then
      cfg_file_state=ok
      config_read_file "$cfg_file"
    else
      cfg_file_state=unreadable
    fi
    config_check_perms "$cfg_file"
  fi
  config_read_env
  : "${cfg_backend:=ntfy}" "${cfg_ntfy_url:=$NTFY_DEFAULT_URL}" "${cfg_timeout:=10}" "${cfg_curl:=curl}"
  : "${cfg_ntfy_attach_max:=$NTFY_ATTACH_MAX_DEFAULT}"
  : "${cfg_claude_min_seconds:=30}" "${cfg_claude_include_message:=1}" "${cfg_claude_delay_seconds:=0}"
  : "${cfg_claude_include_command:=1}"
  : "${cfg_codex_min_seconds:=30}" "${cfg_codex_include_message:=1}" "${cfg_codex_notify_permission:=1}"
  : "${cfg_codex_delay_seconds:=0}"
  : "${cfg_dnd_mode:=skip}"
  while :; do
    case $cfg_ntfy_url in
      */) cfg_ntfy_url=${cfg_ntfy_url%/} ;;
      *) break ;;
    esac
  done
}

config_check_common() {
  case $cfg_backend in
    '' | *[!a-z0-9_]*)
      problem="PUSHME_BACKEND の値が不正です"
      return 1
      ;;
  esac
  if [ "$(type -t "backend_${cfg_backend}_send")" != function ]; then
    problem="PUSHME_BACKEND=$cfg_backend には対応していません（使えるのは ntfy と pushover）"
    return 1
  fi
  case $cfg_timeout in
    '' | *[!0-9]*)
      problem="PUSHME_TIMEOUT は 1 以上の整数（秒）にしてください"
      return 1
      ;;
  esac
  if [ $((10#$cfg_timeout)) -lt 1 ]; then
    problem="PUSHME_TIMEOUT は 1 以上の整数（秒）にしてください"
    return 1
  fi
}

config_check_claude() {
  case $cfg_claude_min_seconds in
    '' | *[!0-9]*)
      problem="PUSHME_CLAUDE_MIN_SECONDS は 0 以上の整数（秒）にしてください"
      return 1
      ;;
  esac
  case $cfg_claude_delay_seconds in
    '' | *[!0-9]*)
      problem="PUSHME_CLAUDE_DELAY_SECONDS は 0 以上の整数（秒）にしてください"
      return 1
      ;;
  esac
  case $cfg_claude_include_message:$cfg_claude_include_command in
    [01]:[01]) ;;
    *)
      problem="PUSHME_CLAUDE_INCLUDE_MESSAGE と PUSHME_CLAUDE_INCLUDE_COMMAND は 0 か 1 にしてください"
      return 1
      ;;
  esac
}

config_check_codex() {
  case $cfg_codex_min_seconds in
    '' | *[!0-9]*)
      problem="PUSHME_CODEX_MIN_SECONDS は 0 以上の整数（秒）にしてください"
      return 1
      ;;
  esac
  case $cfg_codex_delay_seconds in
    '' | *[!0-9]*)
      problem="PUSHME_CODEX_DELAY_SECONDS は 0 以上の整数（秒）にしてください"
      return 1
      ;;
  esac
  case $cfg_codex_include_message:$cfg_codex_notify_permission in
    [01]:[01]) ;;
    *)
      problem="PUSHME_CODEX_INCLUDE_MESSAGE と PUSHME_CODEX_NOTIFY_PERMISSION は 0 か 1 にしてください"
      return 1
      ;;
  esac
}

# --- do-not-disturb hours --------------------------------------------------------

# Sets REPLY to the minutes since midnight of H:MM or HH:MM.
dnd_parse_time() {
  case $1 in
    [0-9]:[0-5][0-9] | [01][0-9]:[0-5][0-9] | 2[0-3]:[0-5][0-9]) ;;
    *) return 1 ;;
  esac
  REPLY=$((10#${1%%:*} * 60 + 10#${1#*:}))
}

# Sets REPLY to the current minutes since midnight, in PUSHME_DND_TZ when set,
# and dnd_second to the seconds into that minute. PUSHME_TEST_NOW (HHMM or
# HHMMSS) pins the clock for the test suite.
dnd_now() {
  local now
  if [ -n "${PUSHME_TEST_NOW:-}" ]; then
    now=${PUSHME_TEST_NOW}00
  elif [ -n "$cfg_dnd_tz" ]; then
    now=$(TZ=$cfg_dnd_tz date +%H%M%S)
  else
    now=$(date +%H%M%S)
  fi
  dnd_second=$((10#${now:4:2}))
  REPLY=$((10#${now:0:2} * 60 + 10#${now:2:2}))
}

# Checks the DnD settings. Given minutes since midnight in $1, also sets
# dnd_range to the configured range containing that time ("" when none).
# A range includes its start, excludes its end, and wraps past midnight when
# the end comes first.
config_check_dnd() {
  local rest range start end
  dnd_range=''
  case $cfg_dnd_mode in
    skip | quiet | defer) ;;
    *)
      problem="PUSHME_DND_MODE は skip・quiet・defer のどれかにしてください"
      return 1
      ;;
  esac
  case $cfg_dnd_tz in
    *[!A-Za-z0-9_+:/.-]*)
      problem="PUSHME_DND_TZ の形式が不正です（例 Asia/Tokyo）"
      return 1
      ;;
  esac
  rest=${cfg_dnd:+$cfg_dnd,}
  while [ -n "$rest" ]; do
    range=$(trim "${rest%%,*}")
    rest=${rest#*,}
    if ! dnd_parse_time "${range%%-*}"; then
      problem="PUSHME_DND の形式が不正です: ${range}（HH:MM-HH:MM をカンマ区切り）"
      return 1
    fi
    start=$REPLY
    if [ "${range#*-}" = "$range" ] || ! dnd_parse_time "${range#*-}"; then
      problem="PUSHME_DND の形式が不正です: ${range}（HH:MM-HH:MM をカンマ区切り）"
      return 1
    fi
    end=$REPLY
    if [ "$start" -eq "$end" ]; then
      problem="PUSHME_DND の始まりと終わりが同じです: ${range}"
      return 1
    fi
    if [ -n "$dnd_range" ] || [ -z "${1:-}" ]; then
      continue
    fi
    if [ "$start" -lt "$end" ]; then
      [ "$1" -ge "$start" ] && [ "$1" -lt "$end" ] && dnd_range=$range
    else
      { [ "$1" -ge "$start" ] || [ "$1" -lt "$end" ]; } && dnd_range=$range
    fi
  done
  return 0
}

# Sets REPLY to the minutes from $1, minutes since midnight within the DnD
# hours, until they end, going on through a range that the previous one ends
# inside. Returns 1 when they cover the whole day. These are wall-clock
# minutes, so a DST change within the hours moves the end by the change.
dnd_minutes_left() {
  local at=$1 total=0
  while config_check_dnd "$at" && [ -n "$dnd_range" ]; do
    [ "$total" -lt 1440 ] || return 1
    dnd_parse_time "${dnd_range#*-}"
    total=$((total + (REPLY - at + 1440) % 1440))
    at=$REPLY
  done
  REPLY=$total
}

# --- HTTP --------------------------------------------------------------------

# Request details reach curl through --config on stdin, not argv, so the topic
# and token never appear in `ps` output.
curl_conf_add() {
  local s=$2 bs=\\ dq='"' nl=$'\n' cr=$'\r' tab=$'\t' vt=$'\v'
  s=${s//"$bs"/"$bs$bs"}
  s=${s//"$dq"/"$bs$dq"}
  s=${s//"$nl"/"${bs}n"}
  s=${s//"$cr"/"${bs}r"}
  s=${s//"$tab"/"${bs}t"}
  s=${s//"$vt"/"${bs}v"}
  curl_conf="$curl_conf$1 = \"$s\"$nl"
}

curl_conf_header() {
  header_value "$2"
  curl_conf_add header "$1: $REPLY"
}

# Sends the request in $curl_conf and sets curl_status (000 without an HTTP
# answer), curl_rc and curl_response. Returns 0 for a 2xx answer. With
# curl_keep_body=1 the response body stays in curl_response (and --fail is
# left out) so that a backend can quote the server's error message.
curl_send_conf() {
  local marker=__PUSHME_HTTP_STATUS__ attempt=1 args
  curl_status=000
  curl_rc=127
  curl_response="curl が見つかりません（$cfg_curl）"
  command -v "$cfg_curl" >/dev/null 2>&1 || return 1
  args=(--silent --show-error --connect-timeout 3 --max-time "$cfg_timeout")
  if [ "${curl_keep_body:-0}" != 1 ]; then
    args+=(--fail --output /dev/null)
  fi
  args+=(--write-out "$marker%{http_code}" --config -)
  while :; do
    curl_response=$(printf '%s' "$curl_conf" | "$cfg_curl" "${args[@]}" 2>&1)
    curl_rc=$?
    # Only a refused connection is retried: the request never reached the
    # server, so it cannot be delivered twice. HTTP 429 in particular is not
    # retried, since ntfy.sh may ban clients that keep exceeding its limits.
    if [ "$curl_rc" -eq 7 ] && [ "$attempt" -lt 2 ]; then
      attempt=$((attempt + 1))
      # PUSHME_TEST_RETRY_DELAY lets the test suite skip the wait.
      sleep "${PUSHME_TEST_RETRY_DELAY:-1}"
      continue
    fi
    break
  done
  curl_status=${curl_response##*"$marker"}
  curl_status=${curl_status:0:3}
  case $curl_status in
    [0-9][0-9][0-9]) curl_response=${curl_response/"$marker$curl_status"/} ;;
    *) curl_status=000 ;;
  esac
  if [ "$curl_rc" -eq 0 ]; then
    case $curl_status in
      2??) return 0 ;;
    esac
  fi
  return 1
}

# Reports a failed curl_send_conf. $1 is an optional detail from the backend,
# such as the server's own explanation.
curl_report_failure() {
  local res detail
  res=$(trim "$(printf '%s' "$curl_response" | tr '\r\n' '  ')")
  case $curl_status in
    429) detail="HTTP 429（${cfg_backend} のレート制限に達しました。再試行はしません）" ;;
    3??) detail="HTTP ${curl_status}（リダイレクト先には送りません。送信先の URL を確認してください）" ;;
    [45]??) detail="HTTP ${curl_status}${1:+（${1}）}" ;;
    *) detail=${res:-"curl が終了コード ${curl_rc} で失敗しました"} ;;
  esac
  err "送信に失敗しました: $(redact "$detail")"
}

# --- ntfy backend ------------------------------------------------------------
# PUSHME_BACKEND=<name> dispatches to these functions:
#   backend_<name>_validate  check the configuration; on failure set $problem, return 1
#   backend_<name>_send      deliver msg_* (print them when opt_dry_run=1); 0 = sent, 1 = failed
#   backend_<name>_doctor    report checks through doctor_report without sending anything

backend_ntfy_validate() {
  if [ -z "$cfg_ntfy_topic" ]; then
    problem="PUSHME_NTFY_TOPIC が未設定です（pushme init で作成できます）"
    return 1
  fi
  if ! valid_topic "$cfg_ntfy_topic"; then
    problem="PUSHME_NTFY_TOPIC の形式が不正です（$TOPIC_RULE）"
    return 1
  fi
  case $cfg_ntfy_url in
    http://?* | https://?*) ;;
    *)
      problem="PUSHME_NTFY_URL は http:// か https:// で始まる URL にしてください"
      return 1
      ;;
  esac
  case $cfg_ntfy_token in
    *[!\!-~]*)
      problem="PUSHME_NTFY_TOKEN に使えない文字（空白・制御文字・非 ASCII）が含まれています"
      return 1
      ;;
  esac
  case $cfg_ntfy_attach_max in
    '' | *[!0-9]*)
      problem="PUSHME_NTFY_ATTACH_MAX は 0 以上の整数（バイト）にしてください"
      return 1
      ;;
  esac
}

# Drops the caller's tags from the end until the total fits ntfy's limit; the
# host tag is always kept. Sets REPLY.
ntfy_fit_tags() {
  local rest=${1:+$1,} host=$2 tag kept='' total=${#2} dropped=0
  while [ -n "$rest" ]; do
    tag=${rest%%,*}
    rest=${rest#*,}
    if [ "$dropped" -eq 0 ] && [ $((total + ${#tag})) -le "$NTFY_TAGS_MAX" ]; then
      kept=${kept:+$kept,}$tag
      total=$((total + ${#tag}))
    else
      dropped=$((dropped + 1))
    fi
  done
  if [ "$dropped" -gt 0 ]; then
    warn "タグが ntfy の上限（合計 $NTFY_TAGS_MAX バイト）を超えるため、末尾の $dropped 個を送りません"
  fi
  [ -z "$host" ] || kept=${kept:+$kept,}$host
  REPLY=$kept
}

backend_ntfy_send() {
  local url title tags body attach=$msg_attach filename=$msg_filename size=0 method=POST note
  url=$cfg_ntfy_url/$cfg_ntfy_topic
  truncate_utf8 "$msg_title" "$NTFY_TITLE_MAX"
  title=$REPLY
  ntfy_fit_tags "$msg_tags" "$msg_host"
  tags=$REPLY
  body=$msg_body

  if [ -n "$attach" ]; then
    if ! file_size "$attach"; then
      err "添付ファイルを読めません: $attach"
      return 1
    fi
    size=$REPLY
    if [ "$size" -gt "$cfg_ntfy_attach_max" ]; then
      note="添付ファイル $filename（$size バイト）は上限の $cfg_ntfy_attach_max バイトを超えるため送っていません"
      warn "$note"
      body=${body:+$body$'\n\n'}$note
      attach=''
    elif [ -n "$msg_delay" ] && [ "$msg_delay" -gt "$NTFY_ATTACH_EXPIRY" ]; then
      note="添付ファイル $filename は、届くまでに ntfy.sh の保存期間（3 時間）を過ぎるため送っていません"
      warn "$note"
      body=${body:+$body$'\n\n'}$note
      attach=''
    fi
  fi
  if [ -n "$attach" ]; then
    method=PUT
  elif [ -z "$msg_attach_url" ]; then
    filename=''
  fi
  truncate_utf8 "$body" "$NTFY_BODY_MAX"
  body=$REPLY

  if [ "$opt_dry_run" = 1 ]; then
    printf '%s\n' 'pushme: dry-run（送信していません）'
    printf '%s %s\n' "$method" "$(redact "$url")"
    if [ -n "$title" ]; then printf 'X-Title: %s\n' "$title"; fi
    if [ -n "$msg_priority" ]; then printf 'X-Priority: %s\n' "$msg_priority"; fi
    if [ -n "$tags" ]; then printf 'X-Tags: %s\n' "$tags"; fi
    if [ -n "$msg_click" ]; then printf 'X-Click: %s\n' "$msg_click"; fi
    if [ "$msg_markdown" = 1 ]; then printf 'X-Markdown: yes\n'; fi
    if [ -n "$msg_delay" ]; then printf 'X-Delay: %ss\n' "$msg_delay"; fi
    if [ -n "$msg_attach_url" ]; then printf 'X-Attach: %s\n' "$msg_attach_url"; fi
    if [ -n "$filename" ]; then printf 'Filename: %s\n' "$filename"; fi
    if [ -n "$cfg_ntfy_token" ]; then printf 'Authorization: Bearer %s\n' "$(mask "$cfg_ntfy_token")"; fi
    if [ -n "$attach" ]; then
      if [ -n "$body" ]; then printf 'X-Message: %s\n' "$body"; fi
      printf -- '--- 添付ファイル: %s（%d バイト）---\n' "$attach" "$size"
    else
      printf -- '--- 本文（%d バイト）---\n%s\n' "${#body}" "$body"
    fi
    return 0
  fi

  curl_conf=
  curl_conf_add url "$url"
  if [ -n "$title" ]; then curl_conf_header X-Title "$title"; fi
  if [ -n "$msg_priority" ]; then curl_conf_add header "X-Priority: $msg_priority"; fi
  if [ -n "$tags" ]; then curl_conf_header X-Tags "$tags"; fi
  if [ -n "$msg_click" ]; then curl_conf_header X-Click "$msg_click"; fi
  if [ "$msg_markdown" = 1 ]; then curl_conf_add header "X-Markdown: yes"; fi
  if [ -n "$msg_delay" ]; then curl_conf_add header "X-Delay: ${msg_delay}s"; fi
  if [ -n "$msg_attach_url" ]; then curl_conf_header X-Attach "$msg_attach_url"; fi
  if [ -n "$filename" ]; then curl_conf_header Filename "$filename"; fi
  if [ -n "$cfg_ntfy_token" ]; then curl_conf_add header "Authorization: Bearer $cfg_ntfy_token"; fi
  if [ -n "$attach" ]; then
    # With a PUT upload the request body is the file, so the text moves to a header.
    if [ -n "$body" ]; then curl_conf_header X-Message "$body"; fi
    curl_conf_add upload-file "$attach"
  else
    # data-raw: a body starting with "@" must not be read as a file name.
    curl_conf_add data-raw "$body"
  fi
  curl_keep_body=0
  curl_send_conf || {
    curl_report_failure
    return 1
  }
}

backend_ntfy_doctor() {
  local url_ok=1 res rc
  if [ -z "$cfg_ntfy_topic" ]; then
    doctor_report NG "トピック名: 未設定です（pushme init で作成できます）"
  elif ! valid_topic "$cfg_ntfy_topic"; then
    doctor_report NG "トピック名: 形式が不正です（$TOPIC_RULE）"
  else
    doctor_report OK "トピック名: 設定済み（${#cfg_ntfy_topic} 文字。値は表示しません）"
  fi
  case $cfg_ntfy_url in
    http://?* | https://?*) doctor_report OK "ntfy サーバー: $cfg_ntfy_url" ;;
    *)
      url_ok=0
      doctor_report NG "ntfy サーバー: PUSHME_NTFY_URL は http:// か https:// で始まる URL にしてください"
      ;;
  esac
  if [ -n "$cfg_ntfy_token" ]; then
    case $cfg_ntfy_token in
      *[!\!-~]*) doctor_report NG "アクセストークン: 使えない文字（空白・制御文字・非 ASCII）が含まれています" ;;
      *) doctor_report OK "アクセストークン: 設定済み（${#cfg_ntfy_token} 文字。値は表示しません）" ;;
    esac
  fi
  case $cfg_ntfy_attach_max in
    '' | *[!0-9]*) doctor_report NG "添付の上限: PUSHME_NTFY_ATTACH_MAX は 0 以上の整数（バイト）にしてください" ;;
  esac
  [ "$url_ok" = 1 ] || return 0
  if ! command -v "$cfg_curl" >/dev/null 2>&1; then
    doctor_report NG "疎通: curl がないため確認できません"
    return 0
  fi
  # /v1/health answers without publishing, so the check does not use up the
  # daily message quota.
  res=$("$cfg_curl" --silent --show-error --fail --connect-timeout 3 \
    --max-time "$cfg_timeout" "$cfg_ntfy_url/v1/health" 2>&1)
  rc=$?
  case $rc:$res in
    0:*'"healthy":true'* | 0:*'"healthy": true'*)
      doctor_report OK "疎通: $cfg_ntfy_url/v1/health に接続できました（通知は送っていません）"
      ;;
    0:*) doctor_report NG "疎通: $cfg_ntfy_url/v1/health が healthy を返しませんでした" ;;
    *) doctor_report NG "疎通: $cfg_ntfy_url/v1/health に接続できません: $(trim "$(printf '%s' "$res" | tr '\r\n' '  ')")" ;;
  esac
}

# --- Pushover backend ----------------------------------------------------------

backend_pushover_validate() {
  if [ -z "$cfg_pushover_token" ] || [ -z "$cfg_pushover_user" ]; then
    problem="PUSHME_PUSHOVER_TOKEN と PUSHME_PUSHOVER_USER を設定してください"
    return 1
  fi
  case $cfg_pushover_token$cfg_pushover_user in
    *[!A-Za-z0-9]*)
      problem="PUSHME_PUSHOVER_TOKEN か PUSHME_PUSHOVER_USER の形式が不正です（英数字だけ）"
      return 1
      ;;
  esac
  case $cfg_pushover_device in
    *[!A-Za-z0-9_,-]*)
      problem="PUSHME_PUSHOVER_DEVICE の形式が不正です（英数字・「_」・「-」、複数ならカンマ区切り）"
      return 1
      ;;
  esac
}

# Pushover has no tags, so the common ntfy emoji tags become emoji in front
# of the title.
pushover_emoji() {
  case $1 in
    white_check_mark) REPLY='✅' ;;
    heavy_check_mark) REPLY='✔️' ;;
    x) REPLY='❌' ;;
    question) REPLY='❓' ;;
    warning) REPLY='⚠️' ;;
    rotating_light) REPLY='🚨' ;;
    no_entry) REPLY='⛔' ;;
    tada) REPLY='🎉' ;;
    rocket) REPLY='🚀' ;;
    fire) REPLY='🔥' ;;
    bell) REPLY='🔔' ;;
    hourglass) REPLY='⌛' ;;
    *) return 1 ;;
  esac
}

# Pulls the "errors" strings out of a Pushover error response into one line.
pushover_errors() {
  local s=$1 separator='","' dq='"'
  case $s in
    *'"errors":['*) ;;
    *) return 0 ;;
  esac
  s=${s#*'"errors":['}
  s=${s%%]*}
  s=${s//"$separator"/"; "}
  s=${s//"$dq"/}
  printf '%s' "$s"
}

# Makes a curl -F file value; inside its quotes only \ and " need escaping.
pushover_form_file() {
  local path=$1 bs=\\ dq='"'
  path=${path//"$bs"/"$bs$bs"}
  path=${path//"$dq"/"$bs$dq"}
  REPLY="$2=@\"${path}\""
}

pushover_add_key_fields() {
  curl_conf_add form-string "token=${cfg_pushover_token}"
  curl_conf_add form-string "user=${cfg_pushover_user}"
  if [ -n "$cfg_pushover_device" ]; then
    curl_conf_add form-string "device=${cfg_pushover_device}"
  fi
}

backend_pushover_send() {
  local emoji='' suffix='' title='' body=$msg_body tail='' priority='' attach=$msg_attach
  local size=0 note rest tag budget nl=$'\n'
  rest=${msg_tags:+$msg_tags,}
  while [ -n "$rest" ]; do
    tag=${rest%%,*}
    rest=${rest#*,}
    if pushover_emoji "$tag"; then emoji=${emoji}${REPLY}; fi
  done
  [ -z "$msg_host" ] || suffix=" @${msg_host}"
  title=$emoji
  budget=$((PUSHOVER_TITLE_MAX - ${#emoji} - ${#suffix} - 1))
  if [ -n "$msg_title" ] && [ "$budget" -gt 3 ]; then
    truncate_utf8 "$msg_title" "$budget"
    title=${title:+$title }$REPLY
  fi
  title=$(trim "${title}${suffix}")

  case $msg_priority in
    1) priority=-2 ;;
    2) priority=-1 ;;
    3) priority=0 ;;
    # Priority 2 (emergency) needs retry/expire and keeps alerting until
    # acknowledged, so it is never chosen automatically.
    4 | 5) priority=1 ;;
  esac

  if [ -n "$attach" ]; then
    if ! file_size "$attach"; then
      err "添付ファイルを読めません: $attach"
      return 1
    fi
    size=$REPLY
    if [ "$size" -gt "$PUSHOVER_ATTACH_MAX" ]; then
      note="添付ファイル ${msg_filename}（${size} バイト）は Pushover の上限 ${PUSHOVER_ATTACH_MAX} バイトを超えるため送っていません"
      warn "$note"
      body=${body:+$body$nl$nl}$note
      attach=''
    fi
  fi
  [ -z "$msg_attach_url" ] || tail=$nl$nl$msg_attach_url
  [ -n "${body}${tail}" ] || body=$msg_filename
  budget=$((PUSHOVER_MESSAGE_MAX - ${#tail}))
  [ "$budget" -gt 3 ] || budget=4
  truncate_utf8 "$body" "$budget"
  body=$REPLY$tail

  if [ "$opt_dry_run" = 1 ]; then
    printf '%s\n' 'pushme: dry-run（送信していません）'
    printf 'POST %s/messages.json\n' "$PUSHOVER_API"
    printf 'token: %s\n' "$(mask "$cfg_pushover_token")"
    printf 'user: %s\n' "$(mask "$cfg_pushover_user")"
    if [ -n "$cfg_pushover_device" ]; then printf 'device: %s\n' "$cfg_pushover_device"; fi
    if [ -n "$title" ]; then printf 'title: %s\n' "$title"; fi
    if [ -n "$priority" ]; then printf 'priority: %s\n' "$priority"; fi
    if [ -n "$msg_click" ]; then printf 'url: %s\n' "$msg_click"; fi
    if [ -n "$attach" ]; then printf 'attachment: %s（%d バイト）\n' "$attach" "$size"; fi
    printf -- '--- message（%d バイト）---\n%s\n' "${#body}" "$body"
    return 0
  fi

  curl_conf=
  curl_conf_add url "$PUSHOVER_API/messages.json"
  pushover_add_key_fields
  curl_conf_add form-string "message=${body}"
  if [ -n "$title" ]; then curl_conf_add form-string "title=${title}"; fi
  if [ -n "$priority" ]; then curl_conf_add form-string "priority=${priority}"; fi
  if [ -n "$msg_click" ]; then curl_conf_add form-string "url=${msg_click}"; fi
  if [ -n "$attach" ]; then
    pushover_form_file "$attach" attachment
    curl_conf_add form "$REPLY"
  fi
  curl_keep_body=1
  curl_send_conf || {
    curl_report_failure "$(pushover_errors "$curl_response")"
    return 1
  }
}

backend_pushover_doctor() {
  local keys_ok=1
  if [ -z "$cfg_pushover_token" ]; then
    keys_ok=0
    doctor_report NG "Pushover: PUSHME_PUSHOVER_TOKEN が未設定です"
  fi
  if [ -z "$cfg_pushover_user" ]; then
    keys_ok=0
    doctor_report NG "Pushover: PUSHME_PUSHOVER_USER が未設定です"
  fi
  if [ "$keys_ok" = 1 ] && ! backend_pushover_validate; then
    keys_ok=0
    doctor_report NG "Pushover: $problem"
  fi
  [ "$keys_ok" = 1 ] || return 0
  if ! command -v "$cfg_curl" >/dev/null 2>&1; then
    doctor_report NG "Pushover: curl がないためキーを確認できません"
    return 0
  fi
  # users/validate.json checks the keys (and device) without sending a message.
  curl_conf=
  curl_conf_add url "$PUSHOVER_API/users/validate.json"
  pushover_add_key_fields
  curl_keep_body=1
  if curl_send_conf; then
    case $curl_response in
      *'"status":1'*)
        doctor_report OK "Pushover: キーを確認できました（通知は送っていません）"
        return 0
        ;;
    esac
  fi
  local detail
  detail=$(pushover_errors "$curl_response")
  if [ -z "$detail" ]; then
    detail=$(trim "$(printf '%s' "$curl_response" | tr '\r\n' '  ')")
  fi
  doctor_report NG "Pushover: キーを確認できません（HTTP ${curl_status}）: $(redact "${detail:-応答がありません}")"
}

# --- options shared by send and run ---------------------------------------

reset_message_options() {
  opt_title=''
  opt_priority=''
  opt_priority_set=0
  opt_tags=''
  opt_click=''
  opt_attach=''
  opt_attach_set=0
  opt_filename=''
  opt_attach_url=''
  opt_markdown=0
  opt_no_host=0
  opt_quiet=0
  opt_dry_run=0
  opt_ignore_dnd=0
}

value_option() {
  case $1 in
    -t | --title | -p | --priority | -T | --tags | -c | --click | -a | --attach | \
      --filename | --attach-url | --tail)
      return 0
      ;;
  esac
  return 1
}

# Consumes one option shared by send and run. OPT_SHIFT is the number of
# arguments used, 0 when $1 is not one of them.
parse_message_option() {
  OPT_SHIFT=1
  if value_option "$1"; then
    [ $# -ge 2 ] || die "$EX_USAGE" "$1 には値が必要です"
    OPT_SHIFT=2
  fi
  case $1 in
    -t | --title) opt_title=$2 ;;
    -p | --priority) opt_priority=$2 opt_priority_set=1 ;;
    -T | --tags) opt_tags=${opt_tags:+$opt_tags,}$2 ;;
    -c | --click) opt_click=$2 ;;
    -a | --attach) opt_attach=$2 opt_attach_set=1 ;;
    --filename) opt_filename=$2 ;;
    --attach-url) opt_attach_url=$2 ;;
    --markdown) opt_markdown=1 ;;
    --no-host) opt_no_host=1 ;;
    -q | --quiet) opt_quiet=1 ;;
    --dry-run) opt_dry_run=1 ;;
    --ignore-dnd) opt_ignore_dnd=1 ;;
    *) OPT_SHIFT=0 ;;
  esac
}

# Checks the shared options and copies them into msg_*.
prepare_message() {
  msg_priority=''
  if [ "$opt_priority_set" = 1 ]; then
    normalize_priority "$opt_priority" ||
      die "$EX_USAGE" "優先度の値が不正です: $opt_priority（1〜5 または min / low / default / high / urgent）"
    msg_priority=$REPLY
  fi
  if [ "$opt_attach_set" = 1 ] && [ -n "$opt_attach_url" ]; then
    die "$EX_USAGE" "--attach と --attach-url は同時に指定できません"
  fi
  if [ -n "$opt_filename" ] && [ "$opt_attach_set" = 0 ] && [ -z "$opt_attach_url" ]; then
    die "$EX_USAGE" "--filename は --attach か --attach-url と一緒に指定してください"
  fi
  normalize_tags "$opt_tags"
  msg_tags=$REPLY
  msg_title=$opt_title
  msg_click=$opt_click
  msg_markdown=$opt_markdown
  msg_attach=$opt_attach
  msg_attach_url=$opt_attach_url
  msg_filename=$opt_filename
  if [ "$opt_attach_set" = 1 ] && [ -z "$msg_filename" ]; then
    msg_filename=${opt_attach##*/}
  fi
  msg_body=''
}

# Loads the configuration and checks that a notification can be sent. On
# failure sets $problem and returns 1.
load_valid_config() {
  local p
  load_config
  for p in ${cfg_perm_problems[@]+"${cfg_perm_problems[@]}"}; do
    warn "$p"
  done
  if [ "$cfg_file_state" = unreadable ]; then
    problem="設定ファイルを読めません: $cfg_file"
    return 1
  fi
  config_check_common && "backend_${cfg_backend}_validate" && config_check_dnd
}

# Sends msg_* through the backend unless the do-not-disturb hours hold it
# back: skipped, or with PUSHME_DND_MODE=defer handed to ntfy for delivery
# when they end. Then dnd_held=1 and the outcome has been reported. Priority
# 5 always goes through.
deliver_message() {
  local now range mode ends
  dnd_held=0
  msg_delay=''
  if [ -n "$cfg_dnd" ]; then
    dnd_now
    now=$REPLY
    config_check_dnd "$now" || return 1
  else
    dnd_range=''
  fi
  range=$dnd_range
  if [ -n "$range" ] && [ "$opt_ignore_dnd" != 1 ] && [ "$msg_priority" != 5 ]; then
    mode=$cfg_dnd_mode
    if [ "$mode" = defer ]; then
      if [ "$cfg_backend" != ntfy ]; then
        mode=quiet
      elif ! dnd_minutes_left "$now"; then
        mode=skip
      fi
    fi
    case $mode in
      skip)
        dnd_held=1
        if [ "$opt_dry_run" = 1 ]; then
          printf 'pushme: dry-run: DnD（%s）のため送りません\n' "$range"
        elif [ "$opt_quiet" != 1 ]; then
          printf 'pushme: DnD（%s）のため送りませんでした\n' "$range" >&2
        fi
        return 0
        ;;
      quiet)
        msg_priority=1
        if [ "$opt_dry_run" = 1 ] && [ "$cfg_dnd_mode" = defer ]; then
          printf 'DnD（%s）: Pushover は配信を予約できないため、優先度 1 で送ります\n' "$range"
        elif [ "$opt_dry_run" = 1 ]; then
          printf 'DnD（%s）: 優先度 1 で送ります\n' "$range"
        fi
        ;;
      defer)
        ends=$(((now + REPLY) % 1440))
        ends=$(printf '%02d:%02d' $((ends / 60)) $((ends % 60)))
        msg_delay=$((REPLY * 60 - dnd_second))
        [ "$msg_delay" -ge "$NTFY_DELAY_MIN" ] || msg_delay=$NTFY_DELAY_MIN
        if [ "$opt_dry_run" = 1 ]; then printf 'DnD（%s）: %s に届くよう予約して送ります\n' "$range" "$ends"; fi
        "backend_${cfg_backend}_send" || return 1
        dnd_held=1
        if [ "$opt_dry_run" != 1 ] && [ "$opt_quiet" != 1 ]; then
          printf 'pushme: DnD（%s）のため、%s に届くよう予約しました\n' "$range" "$ends" >&2
        fi
        return 0
        ;;
    esac
  elif [ "$opt_dry_run" = 1 ] && [ -n "$cfg_dnd" ]; then
    if [ -z "$range" ]; then
      printf 'DnD: 対象外\n'
    elif [ "$opt_ignore_dnd" = 1 ]; then
      printf 'DnD（%s）: --ignore-dnd のため送ります\n' "$range"
    else
      printf 'DnD（%s）: 優先度 5 のため送ります\n' "$range"
    fi
  fi
  "backend_${cfg_backend}_send"
}

set_message_host() {
  if [ "$opt_no_host" = 1 ]; then
    msg_host=''
  else
    msg_host=${cfg_hostname:-$(default_hostname)}
  fi
}

attachment_readable() {
  [ -f "$1" ] && [ -r "$1" ]
}

# --- commands --------------------------------------------------------------

cmd_send() {
  local args body
  reset_message_options
  while [ $# -gt 0 ]; do
    case $1 in
      --?*=*)
        if value_option "${1%%=*}"; then
          set -- "${1%%=*}" "${1#*=}" "${@:2}"
          continue
        fi
        ;;
    esac
    parse_message_option "$@"
    if [ "$OPT_SHIFT" -gt 0 ]; then
      shift "$OPT_SHIFT"
      continue
    fi
    case $1 in
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -) break ;;
      -?*) die "$EX_USAGE" "不明なオプションです: $1（pushme help を参照）" ;;
      *) break ;;
    esac
  done
  args=("$@")

  prepare_message
  load_valid_config || die "$EX_USAGE" "$problem"
  set_message_host

  if [ ${#args[@]} -eq 1 ] && [ "${args[0]}" = - ]; then
    body=$(cat)
  elif [ ${#args[@]} -gt 0 ]; then
    join_words "${args[@]}"
    body=$REPLY
  elif [ ! -t 0 ]; then
    body=$(cat)
  else
    body=
  fi
  if is_blank "$body"; then
    if [ "$opt_attach_set" = 0 ] && [ -z "$msg_attach_url" ]; then
      die "$EX_USAGE" "本文が空です（引数か標準入力で渡してください）"
    fi
    body=''
  fi
  msg_body=$body
  if [ "$opt_attach_set" = 1 ] && ! attachment_readable "$msg_attach"; then
    die "$EX_USAGE" "添付ファイルを読めません: $msg_attach"
  fi

  deliver_message || exit "$EX_FAIL"
  if [ "$dnd_held" != 1 ] && [ "$opt_dry_run" != 1 ] && [ "$opt_quiet" != 1 ]; then
    printf '%s\n' 'pushme: 送信しました'
  fi
}

# Runs an external program only, never one of pushme's functions or a
# builtin such as exit.
run_command() {
  case $1 in
    */*)
      if [ ! -e "$1" ]; then
        printf 'pushme: %s: ファイルがありません\n' "$1" >&2
        return 127
      fi
      ;;
    *)
      if ! type -P "$1" >/dev/null; then
        printf 'pushme: %s: コマンドが見つかりません\n' "$1" >&2
        return 127
      fi
      ;;
  esac
  (
    if [ -n "$caller_lc_all_set" ]; then
      export LC_ALL="$caller_lc_all"
    else
      unset LC_ALL
    fi
    exec "$@"
  )
}

# Fills msg_* for a finished command. Arguments: exit code, seconds taken,
# --tail line count, captured output, then the command itself.
run_build_message() {
  local rc=$1 elapsed=$2 lines=$3 output=$4 nl=$'\n' name tag exit_text signame
  local command_line section budget
  shift 4
  name=${1##*/}
  if [ "$rc" -eq 0 ]; then
    tag=white_check_mark
    : "${msg_title:=$name 成功}"
  else
    tag=x
    : "${msg_title:=$name 失敗 (exit $rc)}"
  fi
  : "${msg_priority:=4}"
  msg_tags=$tag${msg_tags:+,$msg_tags}

  exit_text=$rc
  if [ "$rc" -gt 128 ] && signame=$(kill -l $((rc - 128)) 2>/dev/null); then
    exit_text="$rc（SIG$signame）"
  fi
  format_command_line "$@"
  truncate_utf8 "$REPLY" 300
  command_line=$REPLY
  format_duration "$elapsed"
  msg_body="\$ $command_line${nl}終了コード: $exit_text${nl}所要時間: $REPLY"
  if [ -n "$output" ]; then
    section="${nl}--- 出力の末尾 $lines 行 ---${nl}"
    budget=$((NTFY_BODY_MAX - ${#msg_body} - ${#section}))
    if [ "$budget" -gt 3 ]; then
      keep_tail_utf8 "$output" "$budget"
      msg_body=$msg_body$section$REPLY
    fi
  fi

  # The file may be one the command was supposed to write, so a missing one
  # only drops the attachment instead of losing the notification.
  if [ "$opt_attach_set" = 1 ] && ! attachment_readable "$msg_attach"; then
    warn "添付ファイルを読めないため、添付せずに送ります: $msg_attach"
    msg_attach=''
    msg_filename=''
  fi
  set_message_host
}

# Exits with the command's status. When pushme itself received the signal
# that ended the command, it dies by that signal instead, so a calling shell
# notices the interruption (a script loop stops on Ctrl-C).
run_exit() {
  local rc=$1 num=''
  case $run_signal in
    HUP) num=1 ;;
    INT) num=2 ;;
    TERM) num=15 ;;
  esac
  if [ -n "$num" ] && [ "$rc" -eq $((128 + num)) ]; then
    trap - "$run_signal"
    kill -s "$run_signal" "$$"
  fi
  exit "$rc"
}

cmd_run() {
  local on_fail_only=0 tail_set=0 tail_lines='' separator=0 can_notify=1
  local rc start elapsed tmp='' output=''
  reset_message_options
  while [ $# -gt 0 ]; do
    case $1 in
      --?*=*)
        if value_option "${1%%=*}"; then
          set -- "${1%%=*}" "${1#*=}" "${@:2}"
          continue
        fi
        ;;
    esac
    parse_message_option "$@"
    if [ "$OPT_SHIFT" -gt 0 ]; then
      shift "$OPT_SHIFT"
      continue
    fi
    case $1 in
      --on-fail-only) on_fail_only=1 ;;
      --tail)
        tail_set=1
        tail_lines=$2
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      --)
        shift
        separator=1
        break
        ;;
      -?*) die "$EX_USAGE" "不明なオプションです: $1（pushme help を参照）" ;;
      *) break ;;
    esac
    shift
  done
  if [ "$separator" = 0 ] || [ $# -eq 0 ]; then
    die "$EX_USAGE" "実行するコマンドを -- の後に書いてください（pushme run [オプション] -- コマンド [引数...]）"
  fi
  if [ "$tail_set" = 1 ]; then
    case $tail_lines in
      '' | *[!0-9]*) die "$EX_USAGE" "--tail には 1 以上の整数を指定してください" ;;
    esac
    [ $((10#$tail_lines)) -ge 1 ] || die "$EX_USAGE" "--tail には 1 以上の整数を指定してください"
  fi
  prepare_message
  # Reported before the command starts, so a long job does not run on with a
  # notification that can never arrive.
  if ! load_valid_config; then
    err "通知は送れません（コマンドはそのまま実行します）: $problem"
    can_notify=0
  fi

  # The command runs in the foreground: a background job of a non-interactive
  # bash starts with SIGINT ignored, and bash 3.2 cannot undo that, so Ctrl-C
  # would no longer stop it. Ctrl-C reaches the whole foreground process group,
  # so the command gets it directly; the traps only keep pushme alive to notify.
  run_signal=''
  trap 'run_signal=INT' INT
  trap 'run_signal=TERM' TERM
  trap 'run_signal=HUP' HUP
  if [ "$tail_set" = 1 ]; then
    tmp=$(mktemp "${TMPDIR:-/tmp}/pushme-run.XXXXXX") ||
      warn "一時ファイルを作れないため、--tail の出力は通知に含めません"
  fi
  start=$SECONDS
  if [ -n "$tmp" ]; then
    run_command "$@" 2>&1 | tee "$tmp"
    rc=${PIPESTATUS[0]}
    output=$(tail -n "$tail_lines" "$tmp")
    rm -f "$tmp"
  else
    run_command "$@"
    rc=$?
  fi
  elapsed=$((SECONDS - start))

  if [ "$rc" -eq 0 ] && [ "$on_fail_only" = 1 ]; then
    run_exit "$rc"
  fi
  if [ "$can_notify" = 1 ]; then
    run_build_message "$rc" "$elapsed" "$tail_lines" "$output" "$@"
    # stdout belongs to the command, so pushme's own report goes to stderr.
    if deliver_message && [ "$dnd_held" != 1 ] && [ "$opt_dry_run" != 1 ] && [ "$opt_quiet" != 1 ]; then
      printf '%s\n' 'pushme: 通知を送りました' >&2
    fi
  fi
  run_exit "$rc"
}

generate_topic() {
  local rand
  rand=$(tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 64)
  [ "${#rand}" -eq 64 ] || return 1
  printf '%s' "$rand"
}

config_template() {
  cat <<EOF
# pushme の設定ファイル（KEY=VALUE 形式。シェルスクリプトとしては実行されない）
# トピック名はパスワードと同じように扱うこと
PUSHME_NTFY_TOPIC=$1

# PUSHME_NTFY_URL=$NTFY_DEFAULT_URL
# PUSHME_NTFY_TOKEN=
# PUSHME_HOSTNAME=
# PUSHME_TIMEOUT=10
EOF
}

# Sets modes explicitly rather than trusting the caller's umask.
write_config() {
  local file=$1 topic=$2 dir tmp
  dir=$(dirname "$file")
  if [ ! -d "$dir" ]; then
    mkdir -p "$dir" || return 1
    chmod 700 "$dir" || return 1
  fi
  tmp=$file.tmp.$$
  (umask 077 && : >"$tmp") || return 1
  if ! chmod 600 "$tmp" || ! config_template "$topic" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$file" && chmod 600 "$file"
}

cmd_init() {
  local force=0 ask_test=1 file topic='' answer generated=0
  while [ $# -gt 0 ]; do
    case $1 in
      --force) force=1 ;;
      --no-test) ask_test=0 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "$EX_USAGE" "init に不明な引数があります: $1（トピック名は引数ではなく標準入力から渡してください）" ;;
    esac
    shift
  done

  file=$(config_path)
  if [ -e "$file" ] && [ "$force" = 0 ]; then
    printf 'pushme: 設定ファイルは既にあります: %s（作り直すには pushme init --force）\n' "$file"
    return 0
  fi

  # The topic is read from stdin only, never from argv, so it stays out of
  # shell history.
  if [ -t 0 ]; then
    printf '既存のトピック名を貼り付けて Enter（空のまま Enter で新規生成）: ' >&2
    IFS= read -r -s topic || :
    printf '\n' >&2
  else
    IFS= read -r topic || :
  fi
  topic=$(trim "$topic")

  if [ -z "$topic" ]; then
    topic=$(generate_topic) || die "$EX_FAIL" "トピック名を生成できませんでした（/dev/urandom を読めません）"
    generated=1
  elif ! valid_topic "$topic"; then
    die "$EX_USAGE" "トピック名の形式が不正です（$TOPIC_RULE）"
  fi

  write_config "$file" "$topic" || die "$EX_FAIL" "設定ファイルを書き込めませんでした: $file"
  printf '設定ファイルを作成しました: %s\n' "$file"
  load_config

  if [ "$generated" = 1 ]; then
    cat <<EOF

新しいトピック名を生成しました。表示するのはこの 1 回だけです。
パスワード管理ツールに保存してください（知っている人は誰でも通知を送れて、読めます）。

  $topic

受け取る側の準備:
  1. ntfy アプリ（Android / iOS）を入れるか、ブラウザで ntfy の Web アプリを開く
  2. 購読を追加し、「トピック名」に上の文字列を貼り付ける
EOF
    if [ "$cfg_ntfy_url" = "$NTFY_DEFAULT_URL" ]; then
      printf '  3. 「別のサーバーを使う」はオフのまま「購読」を押す\n'
    else
      printf '  3. 「別のサーバーを使う」をオンにして %s を入力し、「購読」を押す\n' "$cfg_ntfy_url"
    fi
  else
    printf 'トピック名を取り込みました（値は表示しません）。\n'
  fi

  if [ "$ask_test" = 1 ] && [ -t 0 ]; then
    printf '\nテスト通知を 1 通送りますか？ [y/N]: ' >&2
    IFS= read -r answer || answer=
    case $answer in
      y | Y | yes | YES) cmd_send --title pushme -- 'pushme init からのテスト通知です' ;;
    esac
  fi
}

# --- Claude Code and Codex hooks ----------------------------------------------

hook_field() {
  printf '%s' "$hook_input" | jq -r "$1" 2>/dev/null
}

# Reads one event from stdin into hook_input. $1 is the subcommand and $2 the
# tool, for error messages.
hook_read_input() {
  if ! command -v jq >/dev/null 2>&1; then
    err "$1: jq が見つかりません（${2} の hook には jq が必要です）"
    return 1
  fi
  hook_input=$(cat)
  if ! printf '%s' "$hook_input" | jq -e 'type == "object"' >/dev/null 2>&1; then
    err "$1: 標準入力が JSON オブジェクトではありません"
    return 1
  fi
}

# Sets hook_project and hook_project_tag from the basename of $1 (default
# $2), and hook_record, the start record of the session's turn under the
# state directory $3.
hook_identify() {
  local project=$1 session_id
  while :; do
    case $project in
      ?*/) project=${project%/} ;;
      *) break ;;
    esac
  done
  project=${project##*/}
  hook_project=${project:-$2}
  hook_project_tag=${hook_project//,/}
  # The session id becomes a file name, so it is reduced to safe characters.
  session_id=$(hook_field '.session_id // empty' | tr -cd 'A-Za-z0-9_-')
  hook_session_id=$session_id
  hook_state_dir=${XDG_STATE_HOME:-${HOME:-}/.local/state}/pushme/$3
  hook_record=$hook_state_dir/$session_id
}

hook_make_state_dir() {
  [ -n "$hook_session_id" ] || return 1
  [ -d "$hook_state_dir" ] || { mkdir -p "$hook_state_dir" && chmod 700 "$hook_state_dir"; }
}

hook_record_start() {
  hook_make_state_dir || return 0
  date +%s >"$hook_record"
  # Sessions that never reach Stop leave their record behind.
  find "$hook_state_dir" -type f -mmin +10080 -exec rm -f {} + 2>/dev/null
  return 0
}

hook_record_clear() {
  [ -z "$hook_session_id" ] || rm -f "$hook_record"
}

# Removes the start record and sets REPLY to the seconds since then. Returns
# 1 when there was no usable record.
hook_take_elapsed() {
  local start
  [ -n "$hook_session_id" ] && [ -f "$hook_record" ] || return 1
  start=$(cat "$hook_record")
  rm -f "$hook_record"
  case $start in
    '' | *[!0-9]*) return 1 ;;
  esac
  REPLY=$(($(date +%s) - start))
}

# Sets REPLY to the "finished" body: elapsed time and session on the first
# line, then the start of the last reply when $2 is 1.
hook_finished_body() {
  local body line
  format_duration "$1"
  body="$REPLY · session ${hook_session_id:0:8}"
  if [ "$2" = 1 ]; then
    line=$(hook_field '.last_assistant_message // "" | if length > 300 then .[:300] + "…" else . end')
    [ -z "$line" ] || body=$body$'\n'$line
  fi
  REPLY=$body
}

# Sets REPLY to the non-empty values of the given fields, one per line.
hook_join_fields() {
  local field line body=''
  for field in "$@"; do
    line=$(hook_field ".$field // empty")
    [ -z "$line" ] || body=${body:+$body$'\n'}$line
  done
  REPLY=$body
}

# Sets msg_* to title $1, emoji tag $2 and body $3, tagged with the project.
hook_message() {
  msg_title=$1
  msg_priority=4
  msg_tags=$2${hook_project_tag:+,$hook_project_tag}
  msg_body=$3
  set_message_host
}

hook_send() {
  hook_message "$@"
  hook_deliver_detached
}

# Sends msg_* from a process group of its own and returns at once: a
# synchronous hook does not keep Claude Code waiting on the network, and
# whatever stops the hook's group (claude -p kills the hooks still running
# when it exits) leaves the send running. With delay $1 and file $2, sends
# only if the file is still there after the delay. --dry-run prints at once.
hook_deliver_detached() {
  if [ "$opt_dry_run" = 1 ]; then
    deliver_message
    return
  fi
  set -m
  (
    trap '' HUP
    if [ $# -gt 0 ]; then
      sleep "$1"
      # Only one of this process and hook_cancel manages to remove the file.
      rm "$2" 2>/dev/null || exit 0
    fi
    deliver_message
  ) </dev/null >/dev/null 2>&1 &
  set +m
  # PUSHME_TEST_WAIT_SEND lets the test suite check an immediate send as
  # soon as the hook returns.
  if [ $# -eq 0 ] && [ -n "${PUSHME_TEST_WAIT_SEND:-}" ]; then wait "$!"; fi
}

# A held-back notification is the file $hook_record.KIND.TOKEN plus a
# detached process that sends the message once the delay is over, if the
# file is still there. KIND is "finished" (the turn ended) or "ask" (a
# prompt waits for an answer); a session has at most one of each. The file
# holds the agent the wait belongs to, empty for the main conversation.

# Arguments: delay in seconds, kind, waiting agent, then those of
# hook_message. Sends at once when the delay is 0 or the session is unknown.
hook_send_later() {
  local delay=$1 kind=$2 agent=$3 pending
  shift 3
  hook_message "$@"
  if [ $((10#$delay)) -eq 0 ] || ! hook_make_state_dir; then
    hook_deliver_detached
    return
  fi
  hook_cancel "$kind"
  if [ "$opt_dry_run" = 1 ]; then
    printf '%s 秒後、それまでに応答がなければ送ります\n' "$((10#$delay))"
    deliver_message
    return
  fi
  pending=$hook_record.$kind.$(date +%s).$$
  if ! printf '%s' "$agent" >"$pending"; then
    hook_deliver_detached
    return
  fi
  hook_deliver_detached "$((10#$delay))" "$pending"
}

# Removes the held-back notification of kind $1; with $2, only when its
# wait belongs to that agent.
hook_cancel() {
  local file
  [ -n "$hook_session_id" ] || return 0
  for file in "$hook_record.$1".*; do
    [ -f "$file" ] || continue
    if [ $# -lt 2 ] || [ "$(cat "$file" 2>/dev/null)" = "$2" ]; then
      rm -f "$file"
    fi
  done
}

# Returns 0 when any session under state directory $1 holds back a
# notification of kind $2. Uses no jq, being run for every tool call.
hook_any_held() {
  local file
  for file in "${XDG_STATE_HOME:-${HOME:-}/.local/state}/pushme/$1"/*."$2".*; do
    [ -f "$file" ] && return 0
  done
  return 1
}

claude_hook_handle() {
  local event agent type asker='' detail='' body elapsed nl=$'\n'
  hook_read_input claude-hook "Claude Code" || return 0
  event=$(hook_field '.hook_event_name // empty')
  case $event in
    UserPromptSubmit | Stop | Notification | StopFailure | SessionEnd | PermissionRequest) ;;
    PostToolUse | PostToolUseFailure)
      hook_any_held claude ask || return 0
      ;;
    *) return 0 ;;
  esac
  agent=$(hook_field '.agent_id // empty')
  # A subagent or teammate shares the session, so its events must not start,
  # end or report the main conversation's turn. Its prompts are still the
  # user's to answer, and Notification never says whose prompt it is.
  case $event in
    PermissionRequest | PostToolUse | PostToolUseFailure) ;;
    *) [ -z "$agent" ] || return 0 ;;
  esac
  hook_identify "${CLAUDE_PROJECT_DIR:-$(hook_field '.cwd // empty')}" "Claude Code" claude

  case $event in
    UserPromptSubmit)
      hook_cancel finished
      hook_cancel ask
      hook_record_start
      ;;
    SessionEnd)
      hook_cancel finished
      hook_cancel ask
      ;;
    PermissionRequest)
      # For the permission_prompt Notification that follows: the asking agent
      # on the first line, then the command, kept whatever
      # PUSHME_CLAUDE_INCLUDE_COMMAND says (the transcript holds it anyway).
      hook_make_state_dir || return 0
      detail=$(hook_field '.tool_input.command | strings
        | if length > 300 then .[:300] + "…" else . end')
      printf '%s\n%s' "$agent" "$detail" >"$hook_record.asker"
      ;;
    PostToolUse | PostToolUseFailure)
      # The agent has got past its prompt. Approving a tool is only known
      # here, once the tool has finished.
      hook_cancel ask "$agent"
      ;;
    Stop)
      # true while Claude keeps working because a stop hook asked it to; the
      # turn has not ended yet.
      [ "$(hook_field '.stop_hook_active // empty')" != true ] || return 0
      hook_cancel ask ''
      hook_take_elapsed || return 0
      elapsed=$REPLY
      if ! load_valid_config || ! config_check_claude; then
        err "claude-hook: $problem"
        return 0
      fi
      [ "$elapsed" -ge "$cfg_claude_min_seconds" ] || return 0
      hook_finished_body "$elapsed" "$cfg_claude_include_message"
      hook_send_later "$cfg_claude_delay_seconds" finished '' "$hook_project 完了" white_check_mark "$REPLY"
      ;;
    Notification)
      type=$(hook_field '.notification_type // empty')
      case $type in
        permission_prompt | elicitation_dialog | elicitation_url_dialog) ;;
        *) return 0 ;;
      esac
      if ! load_valid_config || ! config_check_claude; then
        err "claude-hook: $problem"
        return 0
      fi
      if [ "$type" = permission_prompt ] && [ -f "$hook_record.asker" ]; then
        {
          IFS= read -r asker
          detail=$(cat)
        } <"$hook_record.asker"
        rm -f "$hook_record.asker"
      fi
      hook_join_fields title message
      body=$REPLY
      [ "$cfg_claude_include_command" = 0 ] || [ -z "$detail" ] || body=${body:+$body$nl}$detail
      hook_send_later "$cfg_claude_delay_seconds" ask "$asker" \
        "$hook_project 承認待ち" question "${body:-Claude Code が応答を待っています}"
      ;;
    StopFailure)
      hook_cancel ask ''
      if ! load_valid_config; then
        err "claude-hook: $problem"
        return 0
      fi
      hook_join_fields error error_details last_assistant_message
      hook_send "$hook_project エラー" x "${REPLY:-Claude Code の応答がエラーで止まりました}"
      ;;
  esac
  return 0
}

codex_hook_handle() {
  local event agent elapsed detail body nl=$'\n'
  hook_read_input codex-hook Codex || return 0
  event=$(hook_field '.hook_event_name // empty')
  case $event in
    UserPromptSubmit | Stop | PermissionRequest | Interrupt | SessionEnd) ;;
    PostToolUse)
      hook_any_held codex ask || return 0
      ;;
    *) return 0 ;;
  esac
  agent=$(hook_field '.agent_id // empty')
  hook_identify "$(hook_field '.cwd // empty')" Codex codex

  case $event in
    UserPromptSubmit)
      # A subagent's prompt must not restart the main turn's clock.
      [ -z "$agent" ] || return 0
      hook_cancel finished
      hook_cancel ask
      hook_record_start
      ;;
    Interrupt)
      # An interrupted turn never reaches Stop. Esc or Ctrl-C on an approval
      # prompt interrupts the turn too.
      hook_record_clear
      hook_cancel finished
      hook_cancel ask
      ;;
    SessionEnd)
      hook_cancel finished
      hook_cancel ask
      ;;
    PostToolUse)
      # The agent has got past its prompt. Approving a command is only known
      # here, once it has finished successfully.
      hook_cancel ask "$agent"
      ;;
    Stop)
      [ "$(hook_field '.stop_hook_active // empty')" != true ] || return 0
      [ -z "$agent" ] || return 0
      hook_cancel ask ''
      hook_take_elapsed || return 0
      elapsed=$REPLY
      if ! load_valid_config || ! config_check_codex; then
        err "codex-hook: $problem"
        return 0
      fi
      [ "$elapsed" -ge "$cfg_codex_min_seconds" ] || return 0
      hook_finished_body "$elapsed" "$cfg_codex_include_message"
      hook_send_later "$cfg_codex_delay_seconds" finished '' "$hook_project 完了" white_check_mark "$REPLY"
      ;;
    PermissionRequest)
      # Reported for subagents too: the user is the one who has to approve.
      if ! load_valid_config || ! config_check_codex; then
        err "codex-hook: $problem"
        return 0
      fi
      [ "$cfg_codex_notify_permission" = 1 ] || return 0
      detail=$(hook_field '.tool_input
        | if . == null then ""
          elif type == "object" and (.command | type) == "string" then .command
          elif type == "object" and (.command | type) == "array" then .command | map(tostring) | join(" ")
          elif type == "object" and (.description | type) == "string" then .description
          else tojson end
        | if length > 300 then .[:300] + "…" else . end')
      hook_join_fields tool_name
      body=$REPLY
      [ -z "$detail" ] || body=${body:+$body$nl}$detail
      hook_send_later "$cfg_codex_delay_seconds" ask "$agent" \
        "$hook_project 承認待ち" question "${body:-Codex が承認を待っています}"
      ;;
  esac
  return 0
}

# Claude Code and Codex read exit code 2 from a Stop hook as "keep working",
# and stdout from a hook can be taken as instructions (Codex counts any
# stdout from a Stop hook as an error), so these always exit 0 and keep
# stdout empty. Arguments: handler, subcommand name, then its own argument.
run_agent_hook() {
  reset_message_options
  msg_click=''
  msg_markdown=0
  msg_attach=''
  msg_attach_url=''
  msg_filename=''
  case ${3:-} in
    '') ("$1") >/dev/null ;;
    --dry-run)
      opt_dry_run=1
      ("$1") >&2
      ;;
    *) err "$2 に不明な引数があります: $3" ;;
  esac
  exit 0
}

cmd_claude_hook() {
  run_agent_hook claude_hook_handle claude-hook "${1:-}"
}

cmd_codex_hook() {
  run_agent_hook codex_hook_handle codex-hook "${1:-}"
}

doctor_report() {
  printf '[%s] %s\n' "$1" "$2"
  if [ "$1" = NG ]; then doctor_ng=$((doctor_ng + 1)); fi
}

cmd_doctor() {
  local path item
  case ${1:-} in
    '') ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) die "$EX_USAGE" "doctor に不明な引数があります: $1" ;;
  esac
  doctor_ng=0
  load_config

  if path=$(command -v "$cfg_curl"); then
    doctor_report OK "curl: $path"
  else
    doctor_report NG "curl: 見つかりません（必須）"
  fi
  if path=$(command -v jq); then
    doctor_report OK "jq: $path（Claude Code や Codex の hook を使うなら必要）"
  else
    doctor_report -- "jq: 見つかりません（任意。Claude Code や Codex の hook を使うなら必要）"
  fi

  case $cfg_file_state in
    ok) doctor_report OK "設定ファイル: $cfg_file" ;;
    unreadable) doctor_report NG "設定ファイル: 読めません: $cfg_file" ;;
    missing) doctor_report -- "設定ファイル: ありません: $cfg_file（pushme init で作成できます）" ;;
  esac
  for item in ${cfg_perm_problems[@]+"${cfg_perm_problems[@]}"}; do
    doctor_report NG "$item"
  done
  for item in ${cfg_unknown[@]+"${cfg_unknown[@]}"}; do
    doctor_report '!!' "設定ファイル ${item%%:*} 行目: 未知のキー ${item#*:} は無視されます"
  done
  for item in ${cfg_malformed[@]+"${cfg_malformed[@]}"}; do
    doctor_report '!!' "設定ファイル $item 行目: KEY=VALUE の形式ではないため無視されます"
  done

  if config_check_common; then
    "backend_${cfg_backend}_doctor"
  else
    doctor_report NG "$problem"
  fi
  config_check_claude || doctor_report NG "$problem"
  config_check_codex || doctor_report NG "$problem"
  REPLY=''
  [ -z "$cfg_dnd" ] || dnd_now
  if ! config_check_dnd "$REPLY"; then
    doctor_report NG "$problem"
  elif [ -z "$cfg_dnd" ]; then
    doctor_report -- "DnD: 設定なし"
  else
    doctor_report OK "DnD: ${cfg_dnd}（${cfg_dnd_mode}、タイムゾーン ${cfg_dnd_tz:-マシンのローカル時刻}）"
    if [ "$cfg_dnd_mode" = defer ] && [ "$cfg_backend" != ntfy ]; then
      doctor_report '!!' "DnD: Pushover は配信を予約できないため、defer は quiet と同じく優先度 1 で送ります"
    fi
    if [ -n "$dnd_range" ]; then
      doctor_report -- "現在は DnD の時間帯です（${dnd_range}）"
    else
      doctor_report -- "現在は DnD の時間帯ではありません"
    fi
  fi

  if [ "$doctor_ng" -gt 0 ]; then
    printf '問題が %d 件あります\n' "$doctor_ng"
    exit "$EX_FAIL"
  fi
  printf '問題は見つかりませんでした\n'
}

main() {
  cfg_reset
  case ${1:-} in
    send)
      shift
      cmd_send "$@"
      ;;
    run)
      shift
      cmd_run "$@"
      ;;
    init)
      shift
      cmd_init "$@"
      ;;
    doctor)
      shift
      cmd_doctor "$@"
      ;;
    claude-hook)
      shift
      cmd_claude_hook "$@"
      ;;
    codex-hook)
      shift
      cmd_codex_hook "$@"
      ;;
    help | -h | --help) usage ;;
    version | --version) printf 'pushme %s\n' "$PUSHME_VERSION" ;;
    *) cmd_send "$@" ;;
  esac
}

# Sourcing the file, as the tests do, defines the functions without running main.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
